<?xml version="1.0" encoding="utf-8"?>
<!-- Flat prototype background: subtle 1dp top divider in @color/bottom_nav_top_divider. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bottom_nav_top_divider" />
        </shape>
    </item>
    <item android:top="@dimen/bottom_nav_divider_height">
        <shape android:shape="rectangle">
            <solid android:color="@color/bottom_nav_surface" />
        </shape>
    </item>
</layer-list>
