<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:id="@+id/adContainer2" android:layout_width="match_parent"
        android:layout_height="wrap_content" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <ScrollView android:id="@+id/scrollViewContent" android:layout_width="match_parent"
        android:layout_height="0dp" android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/adContainer2"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="@dimen/space_xl">
            <LinearLayout android:id="@+id/home_left_pane" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_l" android:orientation="vertical">
<com.google.android.material.card.MaterialCardView
    android:id="@+id/card_codigos" style="@style/App.Card.Recurrent"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/colorPrimaryContainer">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="@dimen/space_l" android:orientation="vertical">
        <TextView style="@style/App.Text.Title.L" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/home_dashboard_title"/>
        <TextView style="@style/App.Text.Body.S" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_s"
            android:text="@string/premium_home_offline"/>
        <TextView android:id="@+id/home_verified_date" style="@style/App.Text.Body.S"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs" android:text="@string/content_verified_date"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/button_consultar_codigo"
            style="@style/App.Button.Primary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_m"
            android:minHeight="@dimen/touch_target_min" android:text="@string/home_consult_code"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
<LinearLayout android:id="@+id/reading_history_section" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
    <LinearLayout android:id="@+id/continue_reading_section" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical">
        <TextView style="@style/App.Text.Title.M" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_s" android:text="@string/home_continue_reading"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/card_continue_reading"
            style="@style/App.Card.Recurrent" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:clickable="true" android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="@dimen/space_l" android:orientation="vertical">
                <TextView android:id="@+id/continue_article_number" style="@style/App.Text.Title.M"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/continue_article_title" style="@style/App.Text.Body.M"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs" android:maxLines="2"
                    android:ellipsize="end"/>
                <TextView android:id="@+id/continueReadingProgressLabel" style="@style/App.Text.Body.S"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"/>
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/continueReadingProgress"
                    android:layout_width="match_parent" android:layout_height="@dimen/home_premium_progress_height"
                    android:layout_marginTop="@dimen/space_xs" android:max="100"
                    android:indeterminate="false" app:trackThickness="@dimen/home_premium_progress_height"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonContinueReading" style="@style/App.Button.Primary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="end" android:layout_marginTop="@dimen/space_m"
                    android:minHeight="@dimen/touch_target_min" android:text="@string/premium_home_continue"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <LinearLayout android:id="@+id/recently_viewed_section" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical">
        <TextView style="@style/App.Text.Title.M" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xl"
            android:text="@string/home_recently_viewed"/>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s" android:scrollbars="none">
            <LinearLayout android:id="@+id/recent_articles_container"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
<com.google.android.material.card.MaterialCardView android:id="@+id/cardArticleOfTheDay"
    style="@style/App.Card.Recurrent" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xl"
    android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_l">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/dailyArticleLabel" style="@style/App.Text.Body.S" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/premium_home_daily_label" android:textStyle="bold"
                android:textColor="@color/colorPrimary"/>
            <TextView android:id="@+id/dailyDateLabel" style="@style/App.Text.Body.S"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <ImageButton android:id="@+id/buttonDailyFavorite" android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min" android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/article_favorite" android:src="@drawable/baseline_star_border_24"
                app:tint="@color/colorPrimary"/>
        </LinearLayout>
        <TextView android:id="@+id/dailyArticleNumber" style="@style/App.Text.Title.M"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/dailyArticleTitle" style="@style/App.Text.Body.M"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"/>
        <TextView android:id="@+id/dailyArticleExcerpt" style="@style/App.Text.Body.M"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m" android:maxLines="4" android:ellipsize="end"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonDailyRead"
            style="@style/App.Button.Text" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="end"
            android:layout_marginTop="@dimen/space_s" android:minHeight="@dimen/touch_target_min"
            android:text="@string/premium_home_daily_read"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout android:id="@+id/home_right_pane" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical">
<LinearLayout android:id="@+id/homeQuickAccessGrid"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_xl" android:orientation="vertical">
    <LinearLayout android:id="@+id/homeGridRowOne" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonHomeCode"
            style="@style/App.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="@dimen/space_s"
            android:minHeight="@dimen/home_premium_grid_action_height"
            android:text="@string/premium_home_access_code" android:textAllCaps="false"
            app:icon="@drawable/baseline_menu_book_24"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonHomeSearch"
            style="@style/App.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:minHeight="@dimen/home_premium_grid_action_height"
            android:text="@string/premium_home_access_search" android:textAllCaps="false"
            app:icon="@drawable/baseline_search_24"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/homeGridRowTwo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonHomeQuiz"
            style="@style/App.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="@dimen/space_s"
            android:minHeight="@dimen/home_premium_grid_action_height"
            android:text="@string/premium_home_access_quiz" android:textAllCaps="false"
            app:icon="@drawable/baseline_article_24"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonHomeNotes"
            style="@style/App.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:minHeight="@dimen/home_premium_grid_action_height"
            android:text="@string/premium_home_access_notes" android:textAllCaps="false"
            app:icon="@drawable/baseline_note_24"/>
    </LinearLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_xl" android:gravity="center_vertical"
    android:orientation="horizontal">
    <TextView style="@style/App.Text.Title.M" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:text="@string/home_recent_favorites"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_view_all_favorites" style="@style/App.Button.Text"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target_min" android:text="@string/home_view_all_favorites"/>
</LinearLayout>
<LinearLayout android:id="@+id/favorite_articles_container" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical"/>
<LinearLayout android:id="@+id/favorites_empty_state" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:paddingVertical="@dimen/space_s"
    android:orientation="vertical">
    <TextView style="@style/App.Text.Body.M" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/home_no_favorites_body"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/button_explore_code"
        style="@style/App.Button.Text" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
        android:text="@string/home_explore_code"/>
</LinearLayout>
<com.google.android.material.card.MaterialCardView android:id="@+id/card_quizzes"
    style="@style/App.Card.Recurrent" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_l">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="@dimen/space_m" android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView style="@style/App.Text.Body.M" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/home_practice_quiz_title"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/button_practice_quiz"
            style="@style/App.Button.Text" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="@dimen/touch_target_min"
            android:text="@string/home_practice_quiz_action"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>