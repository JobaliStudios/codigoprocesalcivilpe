<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for devices running Android 11 (API 30) or lower. -->
<full-backup-content>
    <!-- Highlights can contain user-authored notes and selected legal text. -->
    <exclude
        domain="sharedpref"
        path="codigoprocesalcivil_highlights.xml" />

    <!-- Recent searches can reveal the user's legal interests or concerns. -->
    <exclude
        domain="sharedpref"
        path="busqueda_prefs.xml" />
</full-backup-content>
