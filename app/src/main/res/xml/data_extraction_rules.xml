<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and transfer rules for devices running Android 12 (API 31) or higher. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- Highlights can contain user-authored notes and selected legal text. -->
        <exclude
            domain="sharedpref"
            path="codigoprocesalcivil_highlights.xml" />

        <!-- Recent searches can reveal the user's legal interests or concerns. -->
        <exclude
            domain="sharedpref"
            path="busqueda_prefs.xml" />
    </cloud-backup>

    <device-transfer>
        <exclude
            domain="sharedpref"
            path="codigoprocesalcivil_highlights.xml" />

        <exclude
            domain="sharedpref"
            path="busqueda_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
