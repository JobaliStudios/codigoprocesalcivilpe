<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="App.Text.Title.L" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title_l</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorOnSurface</item>
    </style>

    <style name="App.Text.Subtitle.M" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_subtitle_m</item>
        <item name="android:textColor">@color/colorOnSurfaceVariant</item>
    </style>

    <style name="App.Text.Body.M" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body_m</item>
        <item name="android:textColor">@color/colorOnSurfaceVariant</item>
    </style>

    <style name="App.Text.Body.S" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_body_s</item>
        <item name="android:textColor">@color/colorOnSurfaceVariant</item>
    </style>

    <style name="App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textSize">@dimen/text_cta_m</item>
    </style>

    <style name="App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">@dimen/text_cta_m</item>
    </style>

    <style name="App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">@dimen/text_body_s</item>
    </style>

    <style name="App.Text.Title.M" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="App.Text.Status.Available" parent="App.Text.Body.S">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="App.Text.Status.Unavailable" parent="App.Text.Body.S">
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="App" />

    <style name="App.Icon" parent="@style/App" />

    <style name="App.Icon.Tinted" parent="@style/App.Icon">
        <item name="android:tint">?attr/colorOnSurface</item>
    </style>

    <style name="App.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/colorSurfaceVariant</item>
        <item name="chipStrokeColor">@color/colorOutline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/colorOnSurface</item>
    </style>

    <style name="App.Card.Recurrent" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="cardCornerRadius">@dimen/radius_l</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="strokeColor">@color/colorOutline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="App.Text.CardTitle" parent="App.Text.Title.L" />

    <style name="App.Text.CardBody" parent="App.Text.Body.S">
        <item name="android:lineSpacingExtra">@dimen/space_xs</item>
    </style>

    <style name="App.Text.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:lineHeight">@dimen/line_height_display</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="App.Text.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:lineHeight">@dimen/line_height_title</item>
        <item name="android:textColor">@color/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="App.Text.SectionSubtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:lineHeight">@dimen/line_height_subtitle</item>
        <item name="android:textColor">@color/colorOnSurfaceVariant</item>
    </style>

    <style name="App.Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineHeight">@dimen/line_height_body</item>
        <item name="android:textColor">@color/colorOnSurfaceVariant</item>
    </style>

    <style name="App.Text.LegalBody" parent="App.Text.Body">
        <item name="android:lineSpacingExtra">@dimen/space_s</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:maxWidth">@dimen/max_reading_line_width</item>
    </style>

    <style name="App.Text.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:lineHeight">@dimen/line_height_caption</item>
        <item name="android:textColor">@color/colorOnSurfaceVariant</item>
    </style>

    <style name="App.Button.SectionAction" parent="Widget.Material3.Button">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>


    <style name="TOPCARDVIEWFONDO">
        <item name="backgroundTint">?attr/colorSurface</item>
    </style>

    <style name="IMAGEBOTONBUSQUEDA">
        <item name="backgroundTint">?attr/colorOnSurface</item>
        <item name="tint">?attr/colorSurface</item>
    </style>

    <style name="EditTextSearchStyle">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="drawableTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:backgroundTint">?attr/colorSurface</item>
    </style>

    <style name="ThemeOverlay.codigoprocesalcivilpe.Toolbar" parent="ThemeOverlay.Material3.Toolbar.Surface">
        <item name="colorControlNormal">@color/toolbar_item_colors</item>
        <item name="actionMenuTextColor">@color/toolbar_item_colors</item>
    </style>

    <style name="TEXT" parent="App.Text.Body.M">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TEXT2" parent="App.Text.Body.S">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="IMAGE" parent="App.Icon.Tinted" />
    <style name="Disponibilidaddecodigos" parent="App.Text.Status.Available" />
    <style name="NoDisponibilidaddecodigos" parent="App.Text.Status.Unavailable" />
</resources>
