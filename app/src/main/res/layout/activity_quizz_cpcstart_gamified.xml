<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_l">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnBack" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_m" android:text="@string/quiz_gamified_title" android:textColor="@color/quiz_text_title" android:textSize="@dimen/text_title_l" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_s" android:text="@string/quiz_gamified_question" android:textColor="@color/quiz_text_secondary" android:textSize="@dimen/text_body_l" />
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuizDraft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:visibility="gone"
            app:cardBackgroundColor="@color/quiz_info_card_bg"
            app:cardCornerRadius="@dimen/radius_l"
            app:strokeColor="@color/quiz_info_card_stroke"
            app:strokeWidth="@dimen/stroke_width_thin">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/quiz_draft_resume_title"
                    android:textColor="@color/quiz_text_title"
                    android:textSize="@dimen/text_title_m"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvQuizDraftProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textColor="@color/quiz_text_body"
                    android:textSize="@dimen/text_body_l" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuizResumeDraft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/quiz_draft_resume_action"
                    android:textAllCaps="false"
                    app:icon="@drawable/baseline_history_24" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            app:cardBackgroundColor="@color/quiz_card_surface"
            app:cardCornerRadius="@dimen/radius_l"
            app:strokeColor="@color/quiz_card_stroke"
            app:strokeWidth="@dimen/stroke_width_thin">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/quiz_metrics_title"
                    android:textColor="@color/quiz_text_title"
                    android:textSize="@dimen/text_title_m"
                    android:textStyle="bold" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchQuizLocalMetrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/quiz_metrics_enable"
                    android:textColor="@color/quiz_text_primary" />
                <TextView
                    android:id="@+id/tvQuizMetricsSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/quiz_metrics_disabled"
                    android:textColor="@color/quiz_text_secondary"
                    android:textSize="@dimen/text_body_m" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/quiz_cpc_count_label"
            android:textColor="@color/quiz_text_title"
            android:textSize="@dimen/text_title_m"
            android:textStyle="bold" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/quizQuestionCountGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@id/btnQuizCount10">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuizCount5"
                style="@style/App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checkable="true"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/quiz_cpc_option_5"
                android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuizCount10"
                style="@style/App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checkable="true"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/quiz_cpc_option_10"
                android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuizCount20"
                style="@style/App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checkable="true"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/quiz_cpc_option_20"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnQuickReview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_l" android:minHeight="@dimen/touch_target_min" android:text="@string/quiz_quick_review_action" android:textAllCaps="false" app:backgroundTint="@color/quiz_button_primary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xl" android:text="@string/quiz_practice_modes" android:textColor="@color/quiz_text_title" android:textSize="@dimen/text_title_m" android:textStyle="bold" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardQuizAll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_m" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/quiz_card_surface" app:cardCornerRadius="@dimen/radius_l" app:strokeColor="@color/quiz_card_stroke"><include layout="@layout/item_quiz_practice_mode" /></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardQuizFavorites" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_s" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/quiz_card_surface" app:cardCornerRadius="@dimen/radius_l" app:strokeColor="@color/quiz_card_stroke"><include layout="@layout/item_quiz_practice_mode" /></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardQuizErrors" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_s" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/quiz_card_surface" app:cardCornerRadius="@dimen/radius_l" app:strokeColor="@color/quiz_card_stroke"><include layout="@layout/item_quiz_practice_mode" /></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardQuizSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_s" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/quiz_card_surface" app:cardCornerRadius="@dimen/radius_l" app:strokeColor="@color/quiz_card_stroke"><include layout="@layout/item_quiz_practice_mode" /></com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/tvQuizStartStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_l" android:textColor="@color/quiz_text_secondary" android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
