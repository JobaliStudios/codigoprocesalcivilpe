<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".home.Codigos.CodigoProcesalCivilMain">

    <!-- CardView fijo en la parte superior -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fixedCardView"
        style="@style/App.Card.Recurrent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_s"
        app:cardCornerRadius="@dimen/radius_l"
        app:cardElevation="@dimen/elevation_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Contenido del CardView fijo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <!-- Título -->
            <TextView
                style="@style/App.Text.Title.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/tituloapp"
                android:textStyle="bold" />

            <!-- Subtítulo -->
            <TextView
                style="@style/App.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/content_verified_date" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/adContainer"
        app:layout_constraintTop_toBottomOf="@id/fixedCardView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Sección 1 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/section1"
                style="@style/App.Card.Recurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/space_s"
                android:layout_marginBottom="@dimen/space_l"
                android:clickable="true"
                android:foreground="?selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_l"
                app:cardElevation="@dimen/elevation_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_m">

                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_l"
                        android:layout_height="@dimen/icon_l"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_balance_24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_s">

                        <TextView
                            style="@style/App.Text.Title.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/seccion_primeratit"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/App.Text.Body.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/seccion_primerasub"

                            />

                        <TextView
                            style="@style/App.Text.Body.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/artxsec1"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_s"
                        android:layout_height="@dimen/icon_s"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_chevron_right_24" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sección 2 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/section2"
                style="@style/App.Card.Recurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/space_s"
                android:layout_marginBottom="@dimen/space_l"
                android:clickable="true"
                android:foreground="?selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_l"
                app:cardElevation="@dimen/elevation_card">

                <!-- Misma estructura que sección 1 -->
                <!-- Cambia: ícono, texto y color -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_m">

                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_l"
                        android:layout_height="@dimen/icon_l"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_groups_24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_s">

                        <TextView
                            style="@style/App.Text.Title.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/seccion_segundatit"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/App.Text.Body.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/seccion_segundasub"

                            />

                        <TextView
                            style="@style/App.Text.Body.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/artxsec2"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_s"
                        android:layout_height="@dimen/icon_s"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_chevron_right_24" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sección 3 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/section3"
                style="@style/App.Card.Recurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/space_s"
                android:layout_marginBottom="@dimen/space_l"
                android:clickable="true"
                android:foreground="?selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_l"
                app:cardElevation="@dimen/elevation_card">

                <!-- Misma estructura que sección 1 -->
                <!-- Cambia: ícono, texto y color -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_m">

                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_l"
                        android:layout_height="@dimen/icon_l"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_check_24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_s">

                        <TextView
                            style="@style/App.Text.Title.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/seccion_terceratit"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/App.Text.Body.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/seccion_tercerasub"

                            />

                        <TextView
                            style="@style/App.Text.Body.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/artxsec3"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_s"
                        android:layout_height="@dimen/icon_s"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_chevron_right_24" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sección 4 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/section4"
                style="@style/App.Card.Recurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/space_s"
                android:layout_marginBottom="@dimen/space_l"
                android:clickable="true"
                android:foreground="?selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_l"
                app:cardElevation="@dimen/elevation_card">

                <!-- Misma estructura que sección 1 -->
                <!-- Cambia: ícono, texto y color -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_m">

                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_l"
                        android:layout_height="@dimen/icon_l"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_drive_folder_upload_24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_s">

                        <TextView
                            style="@style/App.Text.Title.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/seccion_cuartatit"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/App.Text.Body.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/seccion_cuartasub"

                            />

                        <TextView
                            style="@style/App.Text.Body.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/artxsec4"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_s"
                        android:layout_height="@dimen/icon_s"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_chevron_right_24" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sección 5 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/section5"
                style="@style/App.Card.Recurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/space_s"
                android:layout_marginBottom="@dimen/space_l"
                android:clickable="true"
                android:foreground="?selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_l"
                app:cardElevation="@dimen/elevation_card">

                <!-- Misma estructura que sección 1 -->
                <!-- Cambia: ícono, texto y color -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_m">

                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_l"
                        android:layout_height="@dimen/icon_l"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_gavel_24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_s">

                        <TextView
                            style="@style/App.Text.Title.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/seccion_quintatit"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/App.Text.Body.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/seccion_quintasub"

                            />

                        <TextView
                            style="@style/App.Text.Body.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/artxsec5"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_s"
                        android:layout_height="@dimen/icon_s"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_chevron_right_24" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sección 6 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/section6"
                style="@style/App.Card.Recurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/space_s"
                android:layout_marginBottom="@dimen/space_l"
                android:clickable="true"
                android:foreground="?selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_l"
                app:cardElevation="@dimen/elevation_card">

                <!-- Misma estructura que sección 1 -->
                <!-- Cambia: ícono, texto y color -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_m">

                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_l"
                        android:layout_height="@dimen/icon_l"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_handshake_24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_s">

                        <TextView
                            style="@style/App.Text.Title.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/seccion_sextatit"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/App.Text.Body.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:text="@string/seccion_sextasub"
                            />

                        <TextView
                            style="@style/App.Text.Body.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/artxsec6"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_s"
                        android:layout_height="@dimen/icon_s"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_chevron_right_24" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
