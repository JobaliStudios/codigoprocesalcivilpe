<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/App.Card.Recurrent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_m">

        <ImageView
            android:layout_width="@dimen/list_card_small_icon"
            android:layout_height="@dimen/list_card_small_icon"
            android:layout_marginEnd="@dimen/space_m"
            android:contentDescription="@null"
            android:src="@drawable/baseline_history_24"
            app:tint="@color/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/recent_article_number"
                style="@style/App.Text.Title.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/recent_article_title"
                style="@style/App.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/list_card_chevron_size"
            android:layout_height="@dimen/list_card_chevron_size"
            android:layout_marginStart="@dimen/space_s"
            android:contentDescription="@null"
            android:src="@drawable/baseline_chevron_right_24"
            app:tint="@color/colorPrimary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
