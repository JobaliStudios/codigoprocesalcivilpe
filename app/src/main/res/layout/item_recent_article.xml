<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_s"
    android:paddingVertical="@dimen/space_m">

    <ImageView
        android:id="@+id/dashboard_article_icon"
        android:layout_width="@dimen/list_card_chevron_size"
        android:layout_height="@dimen/list_card_chevron_size"
        android:layout_marginEnd="@dimen/space_m"
        android:contentDescription="@null"
        app:tint="@color/colorPrimary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dashboard_article_number"
            style="@style/App.Text.Subtitle.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/dashboard_article_title"
            style="@style/App.Text.Body.S"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2" />
    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/list_card_chevron_size"
        android:layout_height="@dimen/list_card_chevron_size"
        android:layout_marginStart="@dimen/space_s"
        android:contentDescription="@null"
        android:src="@drawable/baseline_chevron_right_24"
        app:tint="@color/colorOnSurfaceVariant" />
</LinearLayout>
