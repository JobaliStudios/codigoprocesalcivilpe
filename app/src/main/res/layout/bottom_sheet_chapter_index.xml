<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorSurface"
    android:orientation="vertical"
    android:padding="@dimen/reader_index_sheet_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/chapterIndexTitle"
                style="@style/App.Text.Title.L"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/reader_index_title"/>
            <TextView
                android:id="@+id/chapterIndexSubtitle"
                style="@style/App.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"/>
        </LinearLayout>
        <ImageButton
            android:id="@+id/chapterIndexClose"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reader_index_close"
            android:src="@drawable/baseline_close_24"/>
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/chapterIndexSearchLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:hint="@string/reader_index_search_hint"
        app:startIconDrawable="@drawable/baseline_search_24">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/chapterIndexSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target_min"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chapterIndexFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="@dimen/space_xs">
            <com.google.android.material.chip.Chip
                android:id="@+id/chapterIndexAll"
                style="@style/App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:checkable="true"
                android:checked="true"
                android:text="@string/reader_index_all"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chapterIndexFavorites"
                style="@style/App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:checkable="true"
                android:text="@string/reader_index_favorites"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chapterIndexNotes"
                style="@style/App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:checkable="true"
                android:text="@string/reader_index_notes"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chapterIndexHighlights"
                style="@style/App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:checkable="true"
                android:text="@string/reader_index_highlights"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chapterIndexList"
        android:layout_width="match_parent"
        android:layout_height="@dimen/reader_index_list_height"
        android:layout_marginTop="@dimen/space_s"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_s"/>

    <TextView
        android:id="@+id/chapterIndexEmpty"
        style="@style/App.Text.Body.M"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="@dimen/reader_index_item_min_height"
        android:text="@string/reader_index_no_results"
        android:visibility="gone"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_width_thin"
        android:layout_marginTop="@dimen/space_s"
        android:background="@color/colorDivider"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/chapterIndexOtherChapter"
            style="@style/App.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/reader_index_other_chapter"
            android:textAllCaps="false"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/chapterIndexGoToArticle"
            style="@style/App.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/reader_index_go_to_article"
            android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>
