<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/adContainer2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/adContainer2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_s">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_codigos"
                style="@style/App.Card.Recurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/home_card_margin_bottom"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="@dimen/home_card_icon_container_size"
                        android:layout_height="@dimen/home_card_icon_container_size"
                        android:layout_marginEnd="@dimen/space_l"
                        android:background="@drawable/bg_icon_container"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/home_card_icon_size"
                            android:layout_height="@dimen/home_card_icon_size"
                            android:contentDescription="@string/Home"
                            android:src="@drawable/vector_codigosmain" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/App.Text.CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_card_codigos_title" />

                        <TextView
                            style="@style/App.Text.CardBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="3"
                            android:text="@string/descripcion_codigos_main" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/list_card_chevron_size"
                        android:layout_height="@dimen/list_card_chevron_size"
                        android:layout_marginStart="@dimen/space_s"
                        android:contentDescription="@string/next_section"
                        android:src="@drawable/baseline_chevron_right_24"
                        app:tint="@color/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_quizzes"
                style="@style/App.Card.Recurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/home_card_margin_bottom"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="@dimen/home_card_icon_container_size"
                        android:layout_height="@dimen/home_card_icon_container_size"
                        android:layout_marginEnd="@dimen/space_l"
                        android:background="@drawable/bg_icon_container"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/home_card_icon_size"
                            android:layout_height="@dimen/home_card_icon_size"
                            android:contentDescription="@string/Home"
                            android:src="@drawable/quizz_vector" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/App.Text.CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_card_cuestionarios_title" />

                        <TextView
                            style="@style/App.Text.CardBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="3"
                            android:text="@string/descripcion_cuestionarios_main" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/list_card_chevron_size"
                        android:layout_height="@dimen/list_card_chevron_size"
                        android:layout_marginStart="@dimen/space_s"
                        android:contentDescription="@string/next_section"
                        android:src="@drawable/baseline_chevron_right_24"
                        app:tint="@color/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_resources"
                style="@style/App.Card.Recurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/home_card_margin_bottom"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="@dimen/home_card_icon_container_size"
                        android:layout_height="@dimen/home_card_icon_container_size"
                        android:layout_marginEnd="@dimen/space_l"
                        android:background="@drawable/bg_icon_container"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/home_card_icon_size"
                            android:layout_height="@dimen/home_card_icon_size"
                            android:contentDescription="@string/Home"
                            android:src="@drawable/vector_resources" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/App.Text.CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_card_recursos_title" />

                        <TextView
                            style="@style/App.Text.CardBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="3"
                            android:text="@string/descripcion_recursps_main" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/list_card_chevron_size"
                        android:layout_height="@dimen/list_card_chevron_size"
                        android:layout_marginStart="@dimen/space_s"
                        android:contentDescription="@string/next_section"
                        android:src="@drawable/baseline_chevron_right_24"
                        app:tint="@color/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
