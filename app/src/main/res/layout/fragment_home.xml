<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/adContainer2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/adContainer2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_codigos"
                style="@style/App.Card.Recurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorPrimaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        tools:ignore="UseCompoundDrawables">

                        <ImageView
                            android:layout_width="@dimen/list_card_small_icon"
                            android:layout_height="@dimen/list_card_small_icon"
                            android:layout_marginEnd="@dimen/space_m"
                            android:contentDescription="@null"
                            android:src="@drawable/vector_codigosmain"
                            app:tint="@color/colorPrimary" />

                        <TextView
                            style="@style/App.Text.Title.L"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/home_dashboard_title" />
                    </LinearLayout>

                    <TextView
                        style="@style/App.Text.Body.M"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/home_dashboard_subtitle" />

                    <TextView
                        style="@style/App.Text.Status.Available"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/home_offline_available" />

                    <TextView
                        android:id="@+id/home_verified_date"
                        style="@style/App.Text.Body.S"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:text="@string/content_verified_date" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_consultar_codigo"
                        style="@style/App.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:text="@string/home_consult_code" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/reading_history_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/continue_reading_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/App.Text.Title.M"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xl"
                        android:layout_marginBottom="@dimen/space_s"
                        android:text="@string/home_continue_reading" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_continue_reading"
                        style="@style/App.Card.Recurrent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/space_m">

                            <ImageView
                                android:layout_width="@dimen/list_card_small_icon"
                                android:layout_height="@dimen/list_card_small_icon"
                                android:layout_marginEnd="@dimen/space_m"
                                android:contentDescription="@null"
                                android:src="@drawable/baseline_menu_book_24"
                                app:tint="@color/colorPrimary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/continue_article_number"
                                    style="@style/App.Text.Title.M"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />

                                <TextView
                                    android:id="@+id/continue_article_title"
                                    style="@style/App.Text.Body.M"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="2" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="@dimen/list_card_chevron_size"
                                android:layout_height="@dimen/list_card_chevron_size"
                                android:layout_marginStart="@dimen/space_s"
                                android:contentDescription="@null"
                                android:src="@drawable/baseline_chevron_right_24"
                                app:tint="@color/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/recently_viewed_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/App.Text.Title.M"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xl"
                        android:layout_marginBottom="@dimen/space_s"
                        android:text="@string/home_recently_viewed" />

                    <LinearLayout
                        android:id="@+id/recent_articles_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/App.Text.Title.M"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_recent_favorites" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_view_all_favorites"
                    style="@style/App.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_view_all_favorites" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/favorite_articles_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/favorites_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_s">

                <TextView
                    style="@style/App.Text.Subtitle.M"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_no_favorites_title" />

                <TextView
                    style="@style/App.Text.Body.S"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/home_no_favorites_body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_explore_code"
                    style="@style/App.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/home_explore_code" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_quizzes"
                style="@style/App.Card.Recurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/list_card_small_icon"
                            android:layout_height="@dimen/list_card_small_icon"
                            android:layout_marginEnd="@dimen/space_m"
                            android:contentDescription="@null"
                            android:src="@drawable/quizz_vector"
                            app:tint="@color/colorPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/App.Text.Title.M"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/home_practice_quiz_title" />

                            <TextView
                                style="@style/App.Text.Body.M"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="@string/home_practice_quiz_body" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_practice_quiz"
                        style="@style/App.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:text="@string/home_practice_quiz_action" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
