<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/privacyToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        android:title="@string/privacy_center_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/baseline_arrow_back_24" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/privacyToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <TextView
                style="@style/App.Text.Title.L"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy_title" />

            <TextView
                style="@style/App.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/privacy_policy_local_data" />

            <TextView
                style="@style/App.Text.Subtitle.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/privacy_ads_title" />

            <TextView
                style="@style/App.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/privacy_ads_explanation" />

            <TextView
                android:id="@+id/textConsentAvailability"
                style="@style/App.Text.Body.S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonManageAdsConsent"
                style="@style/App.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/privacy_manage_consent" />

            <TextView
                style="@style/App.Text.Subtitle.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/privacy_your_data_title" />

            <TextView
                style="@style/App.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/privacy_your_data_explanation" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonClearSearches"
                style="@style/App.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/privacy_clear_searches" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonClearFavorites"
                style="@style/App.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/privacy_clear_favorites" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonClearHighlights"
                style="@style/App.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/config_clear_highlights_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonClearAll"
                style="@style/App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/privacy_clear_all" />

            <TextView
                style="@style/App.Text.Body.S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginBottom="@dimen/space_l"
                android:text="@string/privacy_policy_updated" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
