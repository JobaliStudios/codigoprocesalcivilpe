<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/glossaryScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:id="@+id/glossaryRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/glossary_sheet_padding">
        <TextView
            android:id="@+id/glossaryLabel"
            style="@style/App.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/glossary_label"
            android:textAllCaps="true"/>
        <TextView
            android:id="@+id/glossaryTerm"
            style="@style/App.Text.Title.L"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"/>
        <TextView
            android:id="@+id/glossaryDefinition"
            style="@style/App.Text.Body.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"/>
        <TextView
            android:id="@+id/glossaryDisclaimer"
            style="@style/App.Text.Body.S"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"/>
        <TextView
            android:id="@+id/glossaryReviewer"
            style="@style/App.Text.Body.S"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"/>
        <LinearLayout
            android:id="@+id/glossaryArticlesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="vertical">
            <TextView
                style="@style/App.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/glossary_appears_in"
                android:textStyle="bold"/>
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/glossaryArticleChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/space_xs"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/glossaryRelatedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="vertical">
            <TextView
                style="@style/App.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/glossary_related_terms"
                android:textStyle="bold"/>
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/glossaryRelatedChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/space_xs"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/glossaryCopy"
                style="@style/App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/glossary_copy_definition"
                android:textAllCaps="false"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/glossaryBrowse"
                style="@style/App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/glossary_browse_all"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
