<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_m"
    app:cardBackgroundColor="@color/colorSurfaceVariant"
    app:cardCornerRadius="@dimen/radius_m"
    app:strokeColor="@color/colorOutline"
    app:strokeWidth="@dimen/stroke_width_thin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <LinearLayout
            android:id="@+id/normativeInstrumentGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/App.Text.Body.S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/normative_history_instrument"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/normativeInstrumentValue"
                style="@style/App.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textColor="@color/colorOnSurface"
                tools:text="Ley N.º 32377" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/normativeDateGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="vertical">

            <TextView
                style="@style/App.Text.Body.S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/normative_history_date"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/normativeDateValue"
                style="@style/App.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textColor="@color/colorOnSurface"
                tools:text="7 de junio de 2025" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/normativeTypeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="vertical">

            <TextView
                style="@style/App.Text.Body.S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/normative_history_change_type"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/normativeTypeValue"
                style="@style/App.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textColor="@color/colorOnSurface"
                tools:text="Derogación" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/normativeOfficialSource"
            style="@style/App.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/normative_history_official_source"
            android:textAllCaps="false"
            android:visibility="gone"
            app:icon="@drawable/baseline_open_in_new_24"
            app:iconGravity="textEnd"
            app:iconPadding="@dimen/space_s" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
