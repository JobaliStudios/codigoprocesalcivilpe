<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/adContainer2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ScrollView para el contenido desplazable -->
    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/adContainer2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_s"
            android:paddingBottom="@dimen/space_l">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_codigo_civil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_l"
                style="@style/App.Card.Recurrent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_l"
                        android:layout_height="@dimen/icon_l"
                        android:contentDescription="@null"
                        android:src="@drawable/quizz_vector" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_s">

                        <TextView
                            style="@style/App.Text.Title.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/codigos_codigo_civil_title"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/App.Text.Status.Unavailable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/nodisponible" />
                    </LinearLayout>
                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_s"
                        android:layout_height="@dimen/icon_s"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_chevron_right_24" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_codigo_penal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_l"
                style="@style/App.Card.Recurrent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_l"
                        android:layout_height="@dimen/icon_l"
                        android:contentDescription="@null"
                        android:src="@drawable/quizz_vector" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_s">

                        <TextView
                            style="@style/App.Text.Title.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/codigos_codigo_penal_title"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/App.Text.Status.Unavailable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/nodisponible" />
                    </LinearLayout>
                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_s"
                        android:layout_height="@dimen/icon_s"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_chevron_right_24" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Código Procesal Civil -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_codigo_procesal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_l"
                style="@style/App.Card.Recurrent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_l"
                        android:layout_height="@dimen/icon_l"
                        android:contentDescription="@null"
                        android:src="@drawable/quizz_vector" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_s">

                        <TextView
                            style="@style/App.Text.Title.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/codigos_codigo_procesal_civil_title"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/App.Text.Status.Available"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/disponible" />
                    </LinearLayout>
                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_s"
                        android:layout_height="@dimen/icon_s"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_chevron_right_24" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Código Procesal Civil -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_codigo_procesal_penal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_l"
                style="@style/App.Card.Recurrent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_l"
                        android:layout_height="@dimen/icon_l"
                        android:contentDescription="@null"
                        android:src="@drawable/quizz_vector" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_s">

                        <TextView
                            style="@style/App.Text.Title.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/codigos_codigo_procesal_penal_title"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/App.Text.Status.Unavailable"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/nodisponible" />
                    </LinearLayout>
                    <ImageView
                        style="@style/App.Icon.Tinted"
                        android:layout_width="@dimen/icon_s"
                        android:layout_height="@dimen/icon_s"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_chevron_right_24" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
