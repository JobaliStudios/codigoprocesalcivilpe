<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/myNotesToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        app:title="@string/my_notes_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/my_notes_back_accessibility"
        app:navigationIcon="@drawable/baseline_arrow_back_24" />

    <LinearLayout
        android:id="@+id/myNotesIntro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingTop="@dimen/space_s"
        android:paddingBottom="@dimen/space_s"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/myNotesToolbar">

        <TextView
            style="@style/App.Text.Body.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/my_notes_subtitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonShareMyNotes"
            style="@style/App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:contentDescription="@string/my_notes_share_accessibility"
            android:text="@string/my_notes_share_action"
            android:visibility="gone"
            app:icon="@drawable/baseline_share_24"
            app:iconGravity="textStart"
            tools:visibility="visible" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/myNotesRecycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_l"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/myNotesIntro"
        tools:listitem="@layout/item_my_notes_article" />

    <LinearLayout
        android:id="@+id/myNotesEmptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_l"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_l"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/myNotesIntro">

        <ImageView
            android:layout_width="@dimen/empty_state_icon_size"
            android:layout_height="@dimen/empty_state_icon_size"
            android:background="@drawable/bg_icon_container"
            android:contentDescription="@null"
            android:padding="@dimen/space_m"
            android:src="@drawable/baseline_note_24"
            app:tint="@color/colorPrimary" />

        <TextView
            style="@style/App.Text.Title.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center"
            android:text="@string/my_notes_empty_title" />

        <TextView
            style="@style/App.Text.Body.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:text="@string/my_notes_empty_body" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
