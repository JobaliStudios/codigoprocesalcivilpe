<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <FrameLayout
      android:id="@+id/adContainer2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <ScrollView
      android:id="@+id/scrollViewContent"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintTop_toBottomOf="@id/adContainer2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_l">

      <com.google.android.material.card.MaterialCardView
          android:id="@+id/card_codigo_procesal"
          style="@style/App.Card.Recurrent"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_margin="@dimen/space_s"
          android:layout_marginBottom="@dimen/space_l"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?selectableItemBackground"
          >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_card"
            android:orientation="horizontal"
            android:padding="@dimen/space_l">

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">

            <TextView
                style="@style/App.Text.Title.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/codigos_codigo_procesal_civil_title" />

            <TextView
                style="@style/App.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/codigos_codigo_procesal_civil_subtitle" />

          </LinearLayout>

          <ImageView
              android:layout_width="@dimen/icon_s"
              android:layout_height="@dimen/icon_s"
              android:layout_gravity="center_vertical"
              android:contentDescription="@null"
              android:src="@drawable/baseline_chevron_right_24"
              app:tint="@color/primary_dark"/>

        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <com.google.android.material.card.MaterialCardView
          android:id="@+id/card_proximamente_header"
          style="@style/App.Card.Recurrent"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_margin="@dimen/space_s"
          android:layout_marginBottom="@dimen/space_s"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?selectableItemBackground"
          >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/space_l">

          <TextView
              style="@style/App.Text.Title.M"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="@string/codigos_proximamente_title" />

          <ImageView
              android:id="@+id/iv_proximamente_chevron"
              android:layout_width="@dimen/icon_s"
              android:layout_height="@dimen/icon_s"
              android:layout_gravity="center_vertical"
              android:contentDescription="@string/codigos_expandir_proximamente"
              android:rotation="0"
              android:src="@drawable/baseline_chevron_right_24"
              app:tint="@color/secondary_text" />

        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <LinearLayout
          android:id="@+id/layout_proximamente_content"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_codigo_civil"
            style="@style/App.Card.Recurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_s"
            android:layout_marginBottom="@dimen/space_l"
            android:clickable="false"
            android:enabled="false"
            android:focusable="false"
            >

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:alpha="0.55"
              android:background="@drawable/bg_gradient_card"
              android:orientation="horizontal"
              android:padding="@dimen/space_l">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

              <TextView
                  style="@style/App.Text.Title.M"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="@string/codigos_codigo_civil_title" />

              <TextView
                  style="@style/App.Text.Status.Unavailable"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/space_s"
                  android:text="@string/nodisponible" />

            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/icon_s"
                android:layout_height="@dimen/icon_s"
                android:layout_gravity="center_vertical"
                android:contentDescription="@null"
                android:src="@drawable/baseline_chevron_right_24"
                app:tint="@color/secondary_text"/>

          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_codigo_penal"
            style="@style/App.Card.Recurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_s"
            android:layout_marginBottom="@dimen/space_l"
            android:clickable="false"
            android:enabled="false"
            android:focusable="false"
            >

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:alpha="0.55"
              android:background="@drawable/bg_gradient_card"
              android:orientation="horizontal"
              android:padding="@dimen/space_l">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

              <TextView
                  style="@style/App.Text.Title.M"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="@string/codigos_codigo_penal_title" />

              <TextView
                  style="@style/App.Text.Status.Unavailable"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/space_s"
                  android:text="@string/nodisponible" />

            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/icon_s"
                android:layout_height="@dimen/icon_s"
                android:layout_gravity="center_vertical"
                android:contentDescription="@null"
                android:src="@drawable/baseline_chevron_right_24"
                app:tint="@color/secondary_text"/>

          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_codigo_procesal_penal"
            style="@style/App.Card.Recurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_s"
            android:layout_marginBottom="@dimen/space_l"
            android:clickable="false"
            android:enabled="false"
            android:focusable="false"
            >

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:alpha="0.55"
              android:background="@drawable/bg_gradient_card"
              android:orientation="horizontal"
              android:padding="@dimen/space_l">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

              <TextView
                  style="@style/App.Text.Title.M"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="@string/codigos_codigo_procesal_penal_title" />

              <TextView
                  style="@style/App.Text.Status.Unavailable"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/space_s"
                  android:text="@string/nodisponible" />

            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/icon_s"
                android:layout_height="@dimen/icon_s"
                android:layout_gravity="center_vertical"
                android:contentDescription="@null"
                android:src="@drawable/baseline_chevron_right_24"
                app:tint="@color/secondary_text"/>

          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

      </LinearLayout>

    </LinearLayout>
  </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
