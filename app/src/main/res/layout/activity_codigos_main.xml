<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <FrameLayout
      android:id="@+id/adContainer2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <ScrollView
      android:id="@+id/scrollViewContent"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintTop_toBottomOf="@id/adContainer2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

      <com.google.android.material.card.MaterialCardView
          android:id="@+id/card_codigo_procesal"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_margin="8dp"
          android:layout_marginBottom="16dp"
          android:clickable="true"
          android:foreground="?selectableItemBackground"
          app:cardBackgroundColor="@color/card_background"
          app:cardCornerRadius="16dp"
          app:cardElevation="4dp"
          app:strokeColor="@color/colorOutline"
          app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_card"
            android:orientation="horizontal"
            android:padding="16dp">

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/codigos_codigo_procesal_civil_title"
                android:textColor="@color/primary_dark"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/codigos_codigo_procesal_civil_subtitle"
                android:textColor="@color/secondary_text"
                android:textSize="14sp"/>

          </LinearLayout>

          <ImageView
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:layout_gravity="center_vertical"
              android:contentDescription="@string/next_section"
              android:src="@drawable/baseline_chevron_right_24"
              app:tint="@color/primary_dark"/>

        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <com.google.android.material.card.MaterialCardView
          android:id="@+id/card_proximamente_header"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_margin="8dp"
          android:layout_marginBottom="8dp"
          android:clickable="true"
          android:foreground="?selectableItemBackground"
          app:cardBackgroundColor="@color/card_background"
          app:cardCornerRadius="16dp"
          app:cardElevation="2dp"
          app:strokeColor="@color/colorOutline"
          app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

          <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="@string/codigos_proximamente_title"
              android:textColor="@color/secondary_text"
              android:textSize="16sp"
              android:textStyle="bold" />

          <ImageView
              android:id="@+id/iv_proximamente_chevron"
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:layout_gravity="center_vertical"
              android:contentDescription="@string/codigos_expandir_proximamente"
              android:rotation="0"
              android:src="@drawable/baseline_chevron_right_24"
              app:tint="@color/secondary_text" />

        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <LinearLayout
          android:id="@+id/layout_proximamente_content"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_codigo_civil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:layout_marginBottom="16dp"
            android:clickable="false"
            android:enabled="false"
            android:focusable="false"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/colorOutline"
            app:strokeWidth="1dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:alpha="0.55"
              android:background="@drawable/bg_gradient_card"
              android:orientation="horizontal"
              android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="@string/codigos_codigo_civil_title"
                  android:textColor="@color/primary_dark"
                  android:textSize="20sp"
                  android:textStyle="bold"/>

              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="8dp"
                  android:text="@string/nodisponible"
                  android:textColor="@color/secondary_text"
                  android:textSize="14sp"/>

            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="@string/next_section"
                android:src="@drawable/baseline_chevron_right_24"
                app:tint="@color/secondary_text"/>

          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_codigo_penal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:layout_marginBottom="16dp"
            android:clickable="false"
            android:enabled="false"
            android:focusable="false"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/colorOutline"
            app:strokeWidth="1dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:alpha="0.55"
              android:background="@drawable/bg_gradient_card"
              android:orientation="horizontal"
              android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="@string/codigos_codigo_penal_title"
                  android:textColor="@color/primary_dark"
                  android:textSize="20sp"
                  android:textStyle="bold"/>

              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="8dp"
                  android:text="@string/nodisponible"
                  android:textColor="@color/secondary_text"
                  android:textSize="14sp"/>

            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="@string/next_section"
                android:src="@drawable/baseline_chevron_right_24"
                app:tint="@color/secondary_text"/>

          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_codigo_procesal_penal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:layout_marginBottom="16dp"
            android:clickable="false"
            android:enabled="false"
            android:focusable="false"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/colorOutline"
            app:strokeWidth="1dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:alpha="0.55"
              android:background="@drawable/bg_gradient_card"
              android:orientation="horizontal"
              android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:text="@string/codigos_codigo_procesal_penal_title"
                  android:textColor="@color/primary_dark"
                  android:textSize="20sp"
                  android:textStyle="bold"/>

              <TextView
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="8dp"
                  android:text="@string/nodisponible"
                  android:textColor="@color/secondary_text"
                  android:textSize="14sp"/>

            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="@string/next_section"
                android:src="@drawable/baseline_chevron_right_24"
                app:tint="@color/secondary_text"/>

          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

      </LinearLayout>

    </LinearLayout>
  </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
