<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/App.Card.Recurrent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_m"
    android:layout_marginTop="@dimen/space_s"
    android:layout_marginBottom="@dimen/space_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_m">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/favoriteType"
                style="@style/App.Text.Body.S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/favoriteTitle"
                style="@style/App.Text.Subtitle.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textColor="@color/colorOnSurface"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/favoriteSubtitle"
                style="@style/App.Text.Body.S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/open_favorite"
            android:src="@drawable/baseline_chevron_right_24"
            app:tint="@color/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/buttonRemoveFavorite"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="@dimen/space_xs"
            android:background="@android:color/transparent"
            android:contentDescription="@string/remove_favorite"
            android:src="@drawable/baseline_favorite_24"
            app:tint="@color/colorSecondary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
