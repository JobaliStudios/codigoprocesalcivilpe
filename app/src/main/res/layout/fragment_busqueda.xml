<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/searchContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/space_l"
    tools:context=".busqueda.BusquedaFragment">

    <SearchView
        android:id="@+id/searchView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_search_field"
        android:minHeight="@dimen/touch_target_min"
        android:paddingHorizontal="@dimen/space_s"
        android:queryHint="@string/busqueda_hint" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupSearchType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSearchAll"
                style="@style/App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:checkable="true"
                android:text="@string/busqueda_filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSearchNumber"
                style="@style/App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/busqueda_filter_number" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSearchText"
                style="@style/App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/busqueda_filter_text" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSearchFavorites"
                style="@style/App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/busqueda_filter_favorites" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <TextView
        style="@style/App.Text.Body.S"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/busqueda_sections_label" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupSections"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="false" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/recentHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textRecentTitle"
            style="@style/App.Text.Subtitle.M"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/busqueda_recientes"
            android:textColor="@color/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonClearRecent"
            style="@style/App.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/busqueda_clear_recents"
            android:textAllCaps="false" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/recentScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupRecent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/textResultCount"
        style="@style/App.Text.Body.S"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:visibility="gone"
        tools:text="12 resultados" />

    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_l"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerResultados"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_m"
            tools:listitem="@layout/item_resultado_busqueda" />

        <LinearLayout
            android:id="@+id/emptyStateBusqueda"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_l"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imageEmptyBusqueda"
                android:layout_width="@dimen/empty_state_icon_size"
                android:layout_height="@dimen/empty_state_icon_size"
                android:background="@drawable/bg_icon_container"
                android:contentDescription="@null"
                android:padding="@dimen/space_m"
                android:src="@drawable/baseline_search_24"
                app:tint="@color/colorPrimary" />

            <TextView
                android:id="@+id/textEmptyBusquedaTitle"
                style="@style/App.Text.Title.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:text="@string/busqueda_empty_title" />

            <TextView
                android:id="@+id/textEmptyBusquedaBody"
                style="@style/App.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center"
                android:text="@string/busqueda_empty_state" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEmptyBusquedaCta"
                style="@style/App.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/busqueda_empty_cta" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonClearSearchFilters"
                style="@style/App.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/busqueda_clear_filters"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
