<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quiz_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <FrameLayout
                android:layout_width="118dp"
                android:layout_height="118dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/quiz_circle_icon_bg"
                android:padding="32dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/baseline_star_24"
                    app:tint="@color/quiz_icon_success_tint" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvResultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/quiz_cpc_result_title"
                android:textColor="@color/quiz_text_title"
                android:textSize="56sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResultSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/quiz_cpc_result_subtitle"
                android:textAlignment="center"
                android:textColor="@color/quiz_text_secondary"
                android:textSize="16sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="@color/quiz_card_surface"
                app:cardCornerRadius="22dp"
                app:strokeColor="@color/quiz_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <FrameLayout
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_gravity="center_horizontal">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/circularScore"
                            android:layout_width="220dp"
                            android:layout_height="220dp"
                            app:indicatorColor="@color/quiz_result_indicator"
                            app:indicatorSize="220dp"
                            app:indicatorTrackGapSize="0dp"
                            app:indicatorTrackColor="@color/quiz_result_track"
                            app:indicatorInset="0dp"
                            app:trackThickness="18dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvResult"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="80%"
                                android:textColor="@color/quiz_text_primary"
                                android:textSize="46sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/quiz_cpc_score"
                                android:textColor="@color/quiz_text_secondary"
                                android:textSize="19sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/quiz_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="16dp"
                            app:strokeColor="@color/quiz_card_stroke_soft"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/baseline_check_24"
                                    app:tint="@color/quiz_correct" />

                                <TextView
                                    android:id="@+id/tvCorrectCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="16"
                                    android:textColor="@color/quiz_text_primary"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/quiz_cpc_correct"
                                    android:textColor="@color/quiz_text_secondary" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="16dp"
                            app:strokeColor="@color/quiz_card_stroke_soft"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/baseline_close_24"
                                    app:tint="@color/quiz_wrong" />

                                <TextView
                                    android:id="@+id/tvWrongCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="4"
                                    android:textColor="@color/quiz_text_primary"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/quiz_cpc_incorrect"
                                    android:textColor="@color/quiz_text_secondary" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="16dp"
                            app:strokeColor="@color/quiz_card_stroke_soft"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/baseline_history_24"
                                    app:tint="@color/quiz_progress_indicator" />

                                <TextView
                                    android:id="@+id/tvTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="08:24"
                                    android:textColor="@color/quiz_text_primary"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/quiz_cpc_time"
                                    android:textColor="@color/quiz_text_secondary" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@color/quiz_info_card_bg"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/quiz_info_card_stroke"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvRecommendation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp"
                    android:text="@string/quiz_cpc_default_recommendation"
                    android:textColor="@color/quiz_text_body"
                    android:textSize="16sp" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/quiz_cpc_retry_button"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:backgroundTint="@color/quiz_button_primary"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/baseline_history_24"
                    app:iconTint="@color/quiz_button_on_primary"
                    android:textColor="@color/quiz_button_on_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareScore"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/quiz_cpc_share_score"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:backgroundTint="@color/quiz_bg"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/baseline_groups_24"
                    app:iconTint="@color/quiz_button_primary"
                    app:strokeColor="@color/quiz_button_secondary_stroke"
                    app:strokeWidth="1dp"
                    android:textColor="@color/quiz_button_primary" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackToStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/quiz_cpc_back_to_start"
                android:textAllCaps="false"
                app:backgroundTint="@color/quiz_transparent"
                android:textColor="@color/quiz_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/quiz_cpc_quick_review"
                android:textColor="@color/quiz_text_title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/quiz_card_surface"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/quiz_card_stroke_soft"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/baseline_close_24"
                        app:tint="@color/quiz_wrong" />

                    <TextView
                        android:id="@+id/tvQuickReview"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/quiz_cpc_quick_review_text"
                        android:textColor="@color/quiz_text_body"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_chevron_right_24" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
