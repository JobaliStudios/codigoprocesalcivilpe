<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <FrameLayout
                android:layout_width="118dp"
                android:layout_height="118dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/quiz_circle_icon_bg"
                android:padding="32dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/baseline_star_24"
                    app:tint="@color/quiz_icon_success_tint" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvResultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center"
                android:text="@string/quiz_cpc_result_title"
                android:textColor="@color/quiz_text_title"
                android:textSize="@dimen/quiz_result_title_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResultSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/quiz_cpc_result_subtitle"
                android:textAlignment="center"
                android:textColor="@color/quiz_text_secondary"
                android:textSize="@dimen/text_body_l" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                app:cardBackgroundColor="@color/quiz_question_card_bg"
                app:cardCornerRadius="@dimen/radius_l"
                app:strokeColor="@color/quiz_card_stroke"
                app:strokeWidth="@dimen/stroke_width_thin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <FrameLayout
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_gravity="center_horizontal">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/circularScore"
                            android:layout_width="220dp"
                            android:layout_height="220dp"
                            app:indicatorColor="@color/quiz_result_indicator"
                            app:indicatorSize="220dp"
                            app:indicatorTrackGapSize="0dp"
                            app:trackColor="@color/quiz_result_track"
                            app:indicatorInset="0dp"
                            app:trackThickness="18dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvResult"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:autoSizeMaxTextSize="@dimen/quiz_result_score_text"
                                android:autoSizeMinTextSize="@dimen/quiz_result_score_min_text"
                                android:autoSizeTextType="uniform"
                                android:maxLines="1"
                                android:textColor="@color/quiz_text_primary"
                                android:textSize="@dimen/quiz_result_score_text"
                                android:textStyle="bold"
                                tools:text="80%" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/quiz_cpc_score"
                                android:textColor="@color/quiz_text_secondary"
                                android:textSize="@dimen/quiz_result_label_text"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stroke_width_thin"
                        android:layout_marginTop="@dimen/space_l"
                        android:background="@color/quiz_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_s"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/quiz_card_surface"
                            app:cardCornerRadius="@dimen/radius_l"
                            app:strokeColor="@color/quiz_card_stroke"
                            app:strokeWidth="@dimen/stroke_width_thin">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="@dimen/space_m">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/baseline_check_24"
                                    app:tint="@color/quiz_correct" />

                                <TextView
                                    android:id="@+id/tvCorrectCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_s"
                                    android:textColor="@color/quiz_text_primary"
                                    android:textSize="@dimen/text_title_l"
                                    android:textStyle="bold"
                                    tools:text="16" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/quiz_cpc_correct"
                                    android:textColor="@color/quiz_text_secondary" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/space_s"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/quiz_card_surface"
                            app:cardCornerRadius="@dimen/radius_l"
                            app:strokeColor="@color/quiz_card_stroke"
                            app:strokeWidth="@dimen/stroke_width_thin">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="@dimen/space_m">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/baseline_close_24"
                                    app:tint="@color/quiz_wrong" />

                                <TextView
                                    android:id="@+id/tvWrongCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_s"
                                    android:textColor="@color/quiz_text_primary"
                                    android:textSize="@dimen/text_title_l"
                                    android:textStyle="bold"
                                    tools:text="4" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/quiz_cpc_incorrect"
                                    android:textColor="@color/quiz_text_secondary" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_s"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/quiz_card_surface"
                            app:cardCornerRadius="@dimen/radius_l"
                            app:strokeColor="@color/quiz_card_stroke"
                            app:strokeWidth="@dimen/stroke_width_thin">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="@dimen/space_m">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/baseline_history_24"
                                    app:tint="@color/quiz_icon_tint" />

                                <TextView
                                    android:id="@+id/tvTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_s"
                                    android:textColor="@color/quiz_text_primary"
                                    android:textSize="@dimen/text_title_l"
                                    android:textStyle="bold"
                                    tools:text="08:24" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/quiz_points_obtained"
                                    android:textColor="@color/quiz_text_secondary" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                app:cardBackgroundColor="@color/quiz_info_card_bg"
                app:cardCornerRadius="@dimen/radius_l"
                app:strokeColor="@color/quiz_info_card_stroke"
                app:strokeWidth="@dimen/stroke_width_thin">

                <TextView
                    android:id="@+id/tvRecommendation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_l"
                    android:text="@string/quiz_cpc_default_recommendation"
                    android:textColor="@color/quiz_text_body"
                    android:textSize="@dimen/text_body_l" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_s"
                    android:layout_weight="1"
                    android:maxLines="3"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/quiz_cpc_retry_button"
                    android:textAllCaps="false"
                    android:textColor="@color/quiz_button_on_primary"
                    android:textStyle="bold"
                    app:backgroundTint="@color/quiz_button_primary"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/baseline_history_24"
                    app:iconTint="@color/quiz_button_on_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareScore"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1"
                    android:maxLines="3"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/quiz_cpc_share_score"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:backgroundTint="@color/quiz_button_secondary"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/baseline_groups_24"
                    app:iconTint="@color/quiz_text_primary"
                    app:strokeColor="@color/quiz_button_secondary_stroke"
                    app:strokeWidth="@dimen/stroke_width_thin"
                    android:textColor="@color/quiz_text_primary" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackToStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/quiz_cpc_back_to_start"
                android:textAllCaps="false"
                app:backgroundTint="@color/quiz_transparent"
                android:textColor="@color/quiz_text_secondary" />

            <TextView
                android:id="@+id/tvQuickReviewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/quiz_cpc_review_errors"
                android:textColor="@color/quiz_text_title"
                android:textSize="@dimen/text_title_m"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuickReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:cardBackgroundColor="@color/quiz_card_surface"
                app:cardCornerRadius="@dimen/radius_l"
                app:strokeColor="@color/quiz_card_stroke"
                app:strokeWidth="@dimen/stroke_width_thin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <ImageView
                        android:id="@+id/ivQuickReviewStatus"
                        android:layout_width="@dimen/list_card_small_icon"
                        android:layout_height="@dimen/list_card_small_icon"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_close_24"
                        app:tint="@color/quiz_wrong" />

                    <TextView
                        android:id="@+id/tvQuickReview"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:text="@string/quiz_cpc_quick_review_text"
                        android:textColor="@color/quiz_text_body"
                        android:textSize="@dimen/text_body_l" />

                    <ImageView
                        android:id="@+id/ivQuickReviewChevron"
                        android:layout_width="@dimen/list_card_chevron_size"
                        android:layout_height="@dimen/list_card_chevron_size"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_chevron_right_24"
                        app:tint="@color/quiz_icon_tint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
