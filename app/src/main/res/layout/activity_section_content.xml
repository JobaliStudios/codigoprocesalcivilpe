<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SectionContentActivity">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fixedCardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_l"
        android:layout_marginTop="@dimen/space_s"
        app:cardBackgroundColor="@color/colorSurface"
        app:cardCornerRadius="@dimen/radius_l"
        app:strokeColor="@color/colorOutline"
        app:strokeWidth="@dimen/stroke_width_thin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <TextView
                android:id="@+id/sectionTitle"
                style="@style/App.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Título" />

            <TextView
                android:id="@+id/sectionSubtitle"
                style="@style/App.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Subtítulo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="start|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/currentArticleNumber"
                    style="@style/App.Text.Title.M"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:text="Artículo 835"
                    tools:visibility="visible" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/currentArticleStatusChip"
                    style="@style/App.Chip.LegalStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="@string/article_status_repealed"
                    android:visibility="gone"
                    app:ensureMinTouchTargetSize="false"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/currentArticleTitle"
                style="@style/App.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/colorOnSurface"
                android:visibility="gone"
                tools:text="Acceso de oficio a información en línea sobre la capacidad económica del demandado"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/relatedArticlesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/App.Text.Body.S"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/related_articles_title"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="false"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/relatedArticlesChipGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="@dimen/space_xs"
                        app:singleLine="true" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="end|center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTamanoLetra"
                    style="@style/App.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/font_size_title"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/reading_action_font_size"
                    android:textAllCaps="false"
                    android:textColor="@color/colorPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyArticle"
                    style="@style/App.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/article_copy_content_description"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/article_action_copy"
                    android:textAllCaps="false"
                    android:textColor="@color/colorPrimary"
                    app:icon="@drawable/baseline_content_copy_24"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_xs"
                    app:iconTint="@color/colorPrimary" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/searchBarContainer"
        app:layout_constraintTop_toBottomOf="@id/fixedCardView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <TextView
                android:id="@+id/textView2"
                style="@style/App.Text.LegalBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:clickable="true"
                android:focusable="true"
                android:gravity="start"
                android:textIsSelectable="true"
                tools:ignore="VisualLintLongText"
                tools:text="Contenido" />
        </LinearLayout>
    </ScrollView>

    <!-- Barra de búsqueda interna (oculta hasta tocar el FAB) -->
    <LinearLayout
        android:id="@+id/searchBarContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:padding="@dimen/space_s"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/readingBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtBusqueda"
                style="@style/EditTextSearchStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints="search"
                android:drawableStart="@drawable/baseline_search_24"
                android:hint="@string/buscar"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:minHeight="@dimen/touch_target_min"
                android:padding="@dimen/space_s" />

            <ImageButton
                android:id="@+id/btnLimpiarBusqueda"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/limpiarbusqueda"
                android:padding="@dimen/space_m"
                android:scaleType="centerInside"
                android:src="@drawable/baseline_close_24"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/searchCounter"
                style="@style/App.Text.Body.S"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_xs"
                android:minWidth="36dp"
                android:gravity="center"
                tools:text="0/0" />

            <ImageButton
                android:id="@+id/btnAnterior"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/anteriorbusqueda"
                android:padding="@dimen/space_m"
                android:scaleType="centerInside"
                android:src="@drawable/baseline_arrow_upward_24" />

            <ImageButton
                android:id="@+id/btnSiguiente"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/siguientebusqueda"
                android:padding="@dimen/space_m"
                android:scaleType="centerInside"
                android:src="@drawable/baseline_arrow_downward_24" />

            <ImageButton
                android:id="@+id/btnCerrarBusqueda"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cerrarbusqueda"
                android:padding="@dimen/space_m"
                android:scaleType="centerInside"
                android:src="@drawable/baseline_close_24" />
        </LinearLayout>

        <TextView
            android:id="@+id/searchNoResults"
            style="@style/App.Text.Body.S"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_s"
            android:paddingBottom="@dimen/space_xs"
            android:text="@string/sinresultadosbusqueda"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/readingBottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/colorSurface"
        app:strokeColor="@color/colorOutline"
        app:strokeWidth="@dimen/stroke_width_thin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviousArticle"
                style="@style/App.Button.ReadingAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/article_previous"
                android:minHeight="@dimen/reading_action_height"
                android:text="@string/article_previous"
                app:icon="@drawable/baseline_chevron_left_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFavoriteArticle"
                style="@style/App.Button.ReadingAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/article_favorite"
                android:minHeight="@dimen/reading_action_height"
                android:text="@string/article_favorite"
                app:icon="@drawable/baseline_star_border_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnArticleNote"
                style="@style/App.Button.ReadingAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/article_note"
                android:minHeight="@dimen/reading_action_height"
                android:text="@string/article_note"
                app:icon="@drawable/baseline_note_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareArticle"
                style="@style/App.Button.ReadingAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/article_share_content_description"
                android:minHeight="@dimen/reading_action_height"
                android:text="@string/article_action_share"
                app:icon="@drawable/baseline_share_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextArticle"
                style="@style/App.Button.ReadingAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/article_next"
                android:minHeight="@dimen/reading_action_height"
                android:text="@string/article_next"
                app:icon="@drawable/baseline_chevron_right_24" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabBuscar"
        style="@style/IMAGEBOTONBUSQUEDA"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/fab_margin"
        android:contentDescription="@string/botonbusqueda"
        android:src="@drawable/baseline_search_24"
        app:layout_constraintBottom_toTopOf="@id/readingBottomBar"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
