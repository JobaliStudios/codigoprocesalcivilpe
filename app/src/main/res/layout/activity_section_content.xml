<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SectionContentActivity">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fixedCardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_l"
        android:layout_marginTop="@dimen/space_s"
        app:cardBackgroundColor="@color/colorSurface"
        app:cardCornerRadius="@dimen/radius_l"
        app:strokeColor="@color/colorOutline"
        app:strokeWidth="@dimen/stroke_width_thin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <LinearLayout
                android:id="@+id/readerCompactHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/reader_toolbar_height"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBackToIndex"
                    android:layout_width="@dimen/reader_header_action_width"
                    android:layout_height="@dimen/touch_target_min"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/reader_back_to_index"
                    android:src="@drawable/baseline_arrow_back_24"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/readerBlockLabel"
                        style="@style/App.Text.Body.S"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"/>
                    <TextView
                        android:id="@+id/readerArticlePosition"
                        style="@style/App.Text.Body.M"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/colorOnSurface"/>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnReaderChapterIndex"
                    android:layout_width="@dimen/reader_header_action_width"
                    android:layout_height="@dimen/touch_target_min"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/reader_open_chapter_index"
                    android:src="@drawable/baseline_format_list_bulleted_24"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTamanoLetra"
                    style="@style/App.Button.Text"
                    android:layout_width="@dimen/reader_header_action_width"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:contentDescription="@string/reader_appearance_title"
                    android:text="@string/reading_action_font_size"
                    android:textAllCaps="false"/>
            </LinearLayout>

            <TextView
                android:id="@+id/sectionTitle"
                style="@style/App.Text.Body.S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/sectionSubtitle"
                style="@style/App.Text.Body.S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"/>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/readerChapterProgress"
                android:layout_width="match_parent"
                android:layout_height="@dimen/reader_progress_height"
                android:indeterminate="false"
                android:max="1000"
                android:progress="0"
                android:contentDescription="@string/reader_chapter_empty_position"
                app:trackThickness="@dimen/reader_progress_height"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/searchBarContainer"
        app:layout_constraintTop_toBottomOf="@id/fixedCardView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_l">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="start|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/currentArticleNumber"
                    style="@style/App.Text.Title.M"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:text="Artículo 835"
                    tools:visibility="visible" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/currentArticleStatusChip"
                    style="@style/App.Chip.LegalStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="@string/article_status_repealed"
                    android:visibility="gone"
                    app:ensureMinTouchTargetSize="false"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/currentArticleTitle"
                style="@style/App.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/colorOnSurface"
                android:visibility="gone"
                tools:text="Acceso de oficio a información en línea sobre la capacidad económica del demandado"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/articleSpeechControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnListenArticle"
                    style="@style/App.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/article_speech_listen"
                    android:textAllCaps="false"
                    app:icon="@drawable/baseline_volume_up_24"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_s"
                    app:iconTint="@color/colorPrimary" />

                <LinearLayout
                    android:id="@+id/articleSpeechPlaybackControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/articleSpeechStatus"
                        style="@style/App.Text.Body.S"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        tools:text="Escuchando · Artículo 564" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPauseResumeArticle"
                            style="@style/App.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_xs"
                            android:layout_weight="1"
                            android:minHeight="@dimen/touch_target_min"
                            android:text="@string/article_speech_pause"
                            android:textAllCaps="false"
                            app:icon="@drawable/baseline_pause_24"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/space_xs" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStopArticleSpeech"
                            style="@style/App.Button.Text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_xs"
                            android:layout_weight="1"
                            android:minHeight="@dimen/touch_target_min"
                            android:text="@string/article_speech_stop"
                            android:textAllCaps="false"
                            app:icon="@drawable/baseline_stop_24"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/space_xs" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/relatedArticlesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/App.Text.Body.S"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/related_articles_title"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="false"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/relatedArticlesChipGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="@dimen/space_xs"
                        app:singleLine="true" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="end|center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyArticle"
                    android:visibility="gone"
                    style="@style/App.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/article_copy_content_description"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/article_action_copy"
                    android:textAllCaps="false"
                    android:textColor="@color/colorPrimary"
                    app:icon="@drawable/baseline_content_copy_24"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_xs"
                    app:iconTint="@color/colorPrimary" />
            </LinearLayout>
            <TextView
                android:id="@+id/textView2"
                style="@style/App.Text.LegalBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:maxWidth="@dimen/max_reading_line_width"
                android:layout_marginTop="@dimen/space_s"
                android:clickable="true"
                android:focusable="true"
                android:gravity="start"
                android:textIsSelectable="true"
                tools:ignore="VisualLintLongText"
                tools:text="Contenido" />
        </LinearLayout>
    </ScrollView>

    <!-- Barra de búsqueda interna (oculta hasta tocar el FAB) -->
    <LinearLayout
        android:id="@+id/searchBarContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:padding="@dimen/space_s"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/readingBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtBusqueda"
                style="@style/EditTextSearchStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints="search"
                android:drawableStart="@drawable/baseline_search_24"
                android:hint="@string/buscar"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:minHeight="@dimen/touch_target_min"
                android:padding="@dimen/space_s" />

            <ImageButton
                android:id="@+id/btnLimpiarBusqueda"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/limpiarbusqueda"
                android:padding="@dimen/space_m"
                android:scaleType="centerInside"
                android:src="@drawable/baseline_close_24"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/searchCounter"
                style="@style/App.Text.Body.S"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_xs"
                android:minWidth="36dp"
                android:gravity="center"
                tools:text="0/0" />

            <ImageButton
                android:id="@+id/btnAnterior"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/anteriorbusqueda"
                android:padding="@dimen/space_m"
                android:scaleType="centerInside"
                android:src="@drawable/baseline_arrow_upward_24" />

            <ImageButton
                android:id="@+id/btnSiguiente"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/siguientebusqueda"
                android:padding="@dimen/space_m"
                android:scaleType="centerInside"
                android:src="@drawable/baseline_arrow_downward_24" />

            <ImageButton
                android:id="@+id/btnCerrarBusqueda"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cerrarbusqueda"
                android:padding="@dimen/space_m"
                android:scaleType="centerInside"
                android:src="@drawable/baseline_close_24" />
        </LinearLayout>

        <TextView
            android:id="@+id/searchNoResults"
            style="@style/App.Text.Body.S"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_s"
            android:paddingBottom="@dimen/space_xs"
            android:text="@string/sinresultadosbusqueda"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/readingBottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/colorSurface"
        app:strokeColor="@color/colorOutline"
        app:strokeWidth="@dimen/stroke_width_thin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <HorizontalScrollView
            android:id="@+id/readerBottomActionsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout
            android:id="@+id/readerBottomActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="@dimen/reader_bottom_bar_height">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviousArticle"
                style="@style/App.Button.ReadingAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/article_previous"
                android:minHeight="@dimen/reading_action_height"
                android:text=""
                app:icon="@drawable/baseline_chevron_left_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFavoriteArticle"
                style="@style/App.Button.ReadingAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/article_favorite"
                android:minHeight="@dimen/reading_action_height"
                android:text=""
                app:icon="@drawable/baseline_star_border_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnArticleNote"
                style="@style/App.Button.ReadingAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/article_note"
                android:minHeight="@dimen/reading_action_height"
                android:text=""
                app:icon="@drawable/baseline_note_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareArticle"
                android:visibility="gone"
                style="@style/App.Button.ReadingAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/article_share_content_description"
                android:minHeight="@dimen/reading_action_height"
                android:text="@string/article_action_share"
                app:icon="@drawable/baseline_share_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBottomListenArticle"
                style="@style/App.Button.ReadingAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/reading_action_height"
                android:contentDescription="@string/reader_action_listen_bottom"
                app:icon="@drawable/baseline_volume_up_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReaderMoreArticle"
                style="@style/App.Button.ReadingAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/reading_action_height"
                android:contentDescription="@string/reader_action_more"
                app:icon="@drawable/baseline_more_horiz_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextArticle"
                style="@style/App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/article_next"
                android:minHeight="@dimen/reading_action_height"
                android:text="@string/article_next"
                app:icon="@drawable/baseline_chevron_right_24" />
        </LinearLayout>
        </HorizontalScrollView>
    </com.google.android.material.card.MaterialCardView>


    <!-- El modo enfoque conserva las acciones existentes, pero las oculta temporalmente. -->
    <View
        android:id="@+id/focusProgressLine"
        android:layout_width="0dp"
        android:layout_height="@dimen/reader_focus_progress_height"
        android:background="@color/colorPrimary"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/focusExitPill"
        style="@style/App.Text.Body.M"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xl"
        android:background="@drawable/bg_icon_container"
        android:contentDescription="@string/reader_focus_exit"
        android:gravity="center"
        android:minHeight="@dimen/touch_target_min"
        android:paddingHorizontal="@dimen/space_xl"
        android:text="@string/reader_focus_exit"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabBuscar"
        style="@style/IMAGEBOTONBUSQUEDA"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/fab_margin"
        android:contentDescription="@string/botonbusqueda"
        android:src="@drawable/baseline_search_24"
        app:layout_constraintBottom_toTopOf="@id/readingBottomBar"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
