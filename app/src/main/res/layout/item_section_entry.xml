<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/App.Card.Recurrent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_l"
    android:layout_marginTop="@dimen/space_s"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/radius_l"
    app:cardElevation="@dimen/elevation_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_m">

        <ImageView
            style="@style/App.Icon.Tinted"
            android:layout_width="@dimen/icon_m"
            android:layout_height="@dimen/icon_m"
            android:contentDescription="@null"
            android:src="@drawable/baseline_check_24" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_s">

            <TextView
                android:id="@+id/sectionTitle"
                style="@style/App.Text.Title.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sectionSubtitle"
                style="@style/App.Text.Body.S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2" />

            <TextView
                android:id="@+id/sectionRange"
                style="@style/App.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            style="@style/App.Icon.Tinted"
            android:layout_width="@dimen/icon_s"
            android:layout_height="@dimen/icon_s"
            android:contentDescription="@null"
            android:src="@drawable/baseline_chevron_right_24" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
