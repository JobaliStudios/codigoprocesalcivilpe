<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".configuracion.ConfiguracionFragment">

    <FrameLayout
        android:id="@+id/adContainerConfig"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/adContainerConfig">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <TextView
                android:id="@+id/config_title"
                style="@style/App.Text.Title.L"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/config_title" />

            <TextView
                android:id="@+id/config_subtitle"
                style="@style/App.Text.Subtitle.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/config_subtitle" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_preferencias"
                style="@style/App.Card.Recurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="@dimen/list_card_icon_size"
                            android:layout_height="@dimen/list_card_icon_size"
                            android:layout_marginEnd="@dimen/space_m"
                            android:background="@drawable/bg_icon_container"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="@dimen/list_card_small_icon"
                                android:layout_height="@dimen/list_card_small_icon"
                                android:contentDescription="@null"
                                android:src="@drawable/baseline_book_24"
                                app:tint="@color/colorPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/App.Text.Title.M"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/config_reading_title"
                                android:textColor="@color/colorOnSurface" />

                            <TextView
                                style="@style/App.Text.Body.S"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="@string/config_reading_desc" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_modo_lectura"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/config_reading_title"
                            android:minHeight="@dimen/touch_target_min" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stroke_width_thin"
                        android:layout_marginVertical="@dimen/space_m"
                        android:alpha="0.2"
                        android:background="@color/colorDivider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="@dimen/list_card_icon_size"
                            android:layout_height="@dimen/list_card_icon_size"
                            android:layout_marginEnd="@dimen/space_m"
                            android:background="@drawable/bg_icon_container"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="@dimen/list_card_small_icon"
                                android:layout_height="@dimen/list_card_small_icon"
                                android:contentDescription="@null"
                                android:src="@drawable/baseline_settings_24"
                                app:tint="@color/colorPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/App.Text.Title.M"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/config_dark_mode_title"
                                android:textColor="@color/colorOnSurface" />

                            <TextView
                                style="@style/App.Text.Body.S"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="@string/config_dark_mode_desc" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_modo_oscuro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/config_dark_mode_title"
                            android:minHeight="@dimen/touch_target_min" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_soporte"
                style="@style/App.Card.Recurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="@dimen/list_card_icon_size"
                        android:layout_height="@dimen/list_card_icon_size"
                        android:layout_marginEnd="@dimen/space_m"
                        android:background="@drawable/bg_icon_container"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/list_card_small_icon"
                            android:layout_height="@dimen/list_card_small_icon"
                            android:contentDescription="@null"
                            android:src="@drawable/baseline_article_24"
                            app:tint="@color/colorPrimary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/App.Text.Title.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/config_support_title"
                            android:textColor="@color/colorOnSurface" />

                        <TextView
                            style="@style/App.Text.Body.S"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/config_support_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/list_card_chevron_size"
                        android:layout_height="@dimen/list_card_chevron_size"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_chevron_right_24"
                        app:tint="@color/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_acerca_de"
                style="@style/App.Card.Recurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="@dimen/list_card_icon_size"
                        android:layout_height="@dimen/list_card_icon_size"
                        android:layout_marginEnd="@dimen/space_m"
                        android:background="@drawable/bg_icon_container"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/list_card_small_icon"
                            android:layout_height="@dimen/list_card_small_icon"
                            android:contentDescription="@null"
                            android:src="@drawable/baseline_settings_24"
                            app:tint="@color/colorPrimary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/App.Text.Title.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/config_about_title"
                            android:textColor="@color/colorOnSurface" />

                        <TextView
                            style="@style/App.Text.Body.S"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/config_about_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/list_card_chevron_size"
                        android:layout_height="@dimen/list_card_chevron_size"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_chevron_right_24"
                        app:tint="@color/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_privacidad"
                style="@style/App.Card.Recurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="@dimen/list_card_icon_size"
                        android:layout_height="@dimen/list_card_icon_size"
                        android:layout_marginEnd="@dimen/space_m"
                        android:background="@drawable/bg_icon_container"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/list_card_small_icon"
                            android:layout_height="@dimen/list_card_small_icon"
                            android:contentDescription="@null"
                            android:src="@drawable/baseline_settings_24"
                            app:tint="@color/colorPrimary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/App.Text.Title.M"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/config_privacy_title"
                            android:textColor="@color/colorOnSurface" />

                        <TextView
                            style="@style/App.Text.Body.S"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/config_privacy_desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/list_card_chevron_size"
                        android:layout_height="@dimen/list_card_chevron_size"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_chevron_right_24"
                        app:tint="@color/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/text_version"
                style="@style/App.Text.Body.S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center_horizontal"
                android:text="@string/config_version_value" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
