<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    tools:context=".configuracion.ConfiguracionFragment">
    <FrameLayout android:id="@+id/adContainerConfig" android:layout_width="0dp"
        android:layout_height="wrap_content" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <ScrollView android:id="@+id/configScroll" android:layout_width="0dp"
        android:layout_height="0dp" android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/adContainerConfig"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="@dimen/space_l" android:orientation="vertical">
            <TextView android:id="@+id/config_title" style="@style/App.Text.Title.L"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/config_title"/>
            <TextView android:id="@+id/config_subtitle" style="@style/App.Text.Subtitle.M"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs" android:text="@string/config_subtitle"/>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardAppAppearance"
                style="@style/App.Card.Recurrent" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_l">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/space_l">
                    <TextView style="@style/App.Text.Title.M" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/premium_config_app_appearance"/>
                    <TextView style="@style/App.Text.Body.S" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/premium_config_app_card_info"/>
                    <HorizontalScrollView
                        android:id="@+id/appThemeToggleScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fillViewport="true"
                        android:scrollbars="none">
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/appThemeToggle" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_m"
                        android:saveEnabled="false" app:singleSelection="true"
                        app:selectionRequired="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/themeSystem"
                            style="@style/App.Button.Outlined" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:minHeight="@dimen/touch_target_min" android:saveEnabled="false"
                            android:text="@string/reader_theme_system"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/themeLight"
                            style="@style/App.Button.Outlined" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:minHeight="@dimen/touch_target_min" android:saveEnabled="false"
                            android:text="@string/reader_theme_light"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/themeDark"
                            style="@style/App.Button.Outlined" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:minHeight="@dimen/touch_target_min" android:saveEnabled="false"
                            android:text="@string/reader_theme_dark"/>
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/card_preferencias"
                style="@style/App.Card.Recurrent" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_m">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="@dimen/space_l">
                    <TextView style="@style/App.Text.Title.M" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/premium_config_reading_group"/>
                    <TextView style="@style/App.Text.Body.S" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/premium_config_reader_card_info"/>

<LinearLayout android:id="@+id/configReaderThemeRow" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="horizontal"
    android:minHeight="@dimen/config_premium_row_min_height" android:gravity="center_vertical"
    android:clickable="true" android:focusable="true"
    android:background="?attr/selectableItemBackground"
    android:contentDescription="@string/premium_config_open_appearance">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView style="@style/App.Text.Body.M" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/premium_config_reader_theme"
            android:textColor="@color/colorOnSurface"/>
        <TextView android:id="@+id/readerThemeValue" style="@style/App.Text.Body.S"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"/>
    </LinearLayout>
    <ImageView android:layout_width="@dimen/list_card_chevron_size"
        android:layout_height="@dimen/list_card_chevron_size"
        android:contentDescription="@null" android:src="@drawable/baseline_chevron_right_24"
        app:tint="@color/colorPrimary"/>
</LinearLayout><View android:layout_width="match_parent"
    android:layout_height="@dimen/stroke_width_thin"
    android:background="@color/colorDivider"
    android:layout_marginVertical="@dimen/space_s"/>
<LinearLayout android:id="@+id/configReaderFontRow" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="horizontal"
    android:minHeight="@dimen/config_premium_row_min_height" android:gravity="center_vertical"
    android:clickable="true" android:focusable="true"
    android:background="?attr/selectableItemBackground"
    android:contentDescription="@string/premium_config_open_appearance">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView style="@style/App.Text.Body.M" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/premium_config_reader_font"
            android:textColor="@color/colorOnSurface"/>
        <TextView android:id="@+id/readerFontValue" style="@style/App.Text.Body.S"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"/>
    </LinearLayout>
    <ImageView android:layout_width="@dimen/list_card_chevron_size"
        android:layout_height="@dimen/list_card_chevron_size"
        android:contentDescription="@null" android:src="@drawable/baseline_chevron_right_24"
        app:tint="@color/colorPrimary"/>
</LinearLayout><View android:layout_width="match_parent"
    android:layout_height="@dimen/stroke_width_thin"
    android:background="@color/colorDivider"
    android:layout_marginVertical="@dimen/space_s"/>
<LinearLayout android:id="@+id/configReaderSizeRow" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="horizontal"
    android:minHeight="@dimen/config_premium_row_min_height" android:gravity="center_vertical"
    android:clickable="true" android:focusable="true"
    android:background="?attr/selectableItemBackground"
    android:contentDescription="@string/premium_config_open_appearance">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView style="@style/App.Text.Body.M" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/premium_config_reader_size"
            android:textColor="@color/colorOnSurface"/>
        <TextView android:id="@+id/readerSizeValue" style="@style/App.Text.Body.S"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"/>
    </LinearLayout>
    <ImageView android:layout_width="@dimen/list_card_chevron_size"
        android:layout_height="@dimen/list_card_chevron_size"
        android:contentDescription="@null" android:src="@drawable/baseline_chevron_right_24"
        app:tint="@color/colorPrimary"/>
</LinearLayout><View android:layout_width="match_parent"
    android:layout_height="@dimen/stroke_width_thin"
    android:background="@color/colorDivider"
    android:layout_marginVertical="@dimen/space_s"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:minHeight="@dimen/config_premium_row_min_height"
    android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView style="@style/App.Text.Body.M" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/reader_appearance_justify"
            android:textColor="@color/colorOnSurface"/>
        
    </LinearLayout>
    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchJustify"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s" android:contentDescription="@string/reader_appearance_justify"
        android:saveEnabled="false" android:minHeight="@dimen/touch_target_min"/>
</LinearLayout><View android:layout_width="match_parent"
    android:layout_height="@dimen/stroke_width_thin"
    android:background="@color/colorDivider"
    android:layout_marginVertical="@dimen/space_s"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:minHeight="@dimen/config_premium_row_min_height"
    android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView style="@style/App.Text.Body.M" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/premium_config_glossary"
            android:textColor="@color/colorOnSurface"/>
        
    </LinearLayout>
    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchGlossary"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s" android:contentDescription="@string/premium_config_glossary"
        android:saveEnabled="false" android:minHeight="@dimen/touch_target_min"/>
</LinearLayout><View android:layout_width="match_parent"
    android:layout_height="@dimen/stroke_width_thin"
    android:background="@color/colorDivider"
    android:layout_marginVertical="@dimen/space_s"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:minHeight="@dimen/config_premium_row_min_height"
    android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView style="@style/App.Text.Body.M" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/reader_appearance_keep_awake"
            android:textColor="@color/colorOnSurface"/>
        
    </LinearLayout>
    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_modo_lectura"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s" android:contentDescription="@string/reader_appearance_keep_awake"
        android:saveEnabled="false" android:minHeight="@dimen/touch_target_min"/>
</LinearLayout><View android:layout_width="match_parent"
    android:layout_height="@dimen/stroke_width_thin"
    android:background="@color/colorDivider"
    android:layout_marginVertical="@dimen/space_s"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:minHeight="@dimen/config_premium_row_min_height"
    android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView style="@style/App.Text.Body.M" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/premium_config_focus_default"
            android:textColor="@color/colorOnSurface"/>
        
    </LinearLayout>
    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchFocus"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s" android:contentDescription="@string/premium_config_focus_default"
        android:saveEnabled="false" android:minHeight="@dimen/touch_target_min"/>
</LinearLayout><View android:layout_width="match_parent"
    android:layout_height="@dimen/stroke_width_thin"
    android:background="@color/colorDivider"
    android:layout_marginVertical="@dimen/space_s"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:minHeight="@dimen/config_premium_row_min_height"
    android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView style="@style/App.Text.Body.M" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/reader_swipe_navigation_title"
            android:textColor="@color/colorOnSurface"/>
        <TextView style="@style/App.Text.Body.S" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reader_swipe_navigation_desc"/>
    </LinearLayout>
    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchSwipeNavigation"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s" android:contentDescription="@string/reader_swipe_navigation_title"
        android:saveEnabled="false" android:minHeight="@dimen/touch_target_min"/>
</LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonReadingReset" style="@style/App.Button.Outlined"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="@string/premium_config_reading_reset"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

<com.google.android.material.card.MaterialCardView android:id="@+id/card_soporte"
    style="@style/App.Card.Recurrent" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_m"
    android:clickable="true" android:focusable="true"
    android:foreground="?attr/selectableItemBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:padding="@dimen/space_l"
        android:orientation="horizontal">
        <ImageView android:layout_width="@dimen/list_card_small_icon"
            android:layout_height="@dimen/list_card_small_icon"
            android:layout_marginEnd="@dimen/space_l"
            android:src="@drawable/baseline_article_24" android:contentDescription="@null"
            app:tint="@color/colorPrimary"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/App.Text.Title.M" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/config_support_title"/>
            <TextView style="@style/App.Text.Body.S" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs"
                android:text="@string/config_support_desc"/>
        </LinearLayout>
        <ImageView android:layout_width="@dimen/list_card_chevron_size"
            android:layout_height="@dimen/list_card_chevron_size"
            android:src="@drawable/baseline_chevron_right_24"
            android:contentDescription="@null" app:tint="@color/colorPrimary"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:id="@+id/card_acerca_de"
    style="@style/App.Card.Recurrent" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_m"
    android:clickable="true" android:focusable="true"
    android:foreground="?attr/selectableItemBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:padding="@dimen/space_l"
        android:orientation="horizontal">
        <ImageView android:layout_width="@dimen/list_card_small_icon"
            android:layout_height="@dimen/list_card_small_icon"
            android:layout_marginEnd="@dimen/space_l"
            android:src="@drawable/baseline_book_24" android:contentDescription="@null"
            app:tint="@color/colorPrimary"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/App.Text.Title.M" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/config_about_title"/>
            <TextView style="@style/App.Text.Body.S" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs"
                android:text="@string/config_about_desc"/>
        </LinearLayout>
        <ImageView android:layout_width="@dimen/list_card_chevron_size"
            android:layout_height="@dimen/list_card_chevron_size"
            android:src="@drawable/baseline_chevron_right_24"
            android:contentDescription="@null" app:tint="@color/colorPrimary"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:id="@+id/card_privacidad"
    style="@style/App.Card.Recurrent" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_m"
    android:clickable="true" android:focusable="true"
    android:foreground="?attr/selectableItemBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:padding="@dimen/space_l"
        android:orientation="horizontal">
        <ImageView android:layout_width="@dimen/list_card_small_icon"
            android:layout_height="@dimen/list_card_small_icon"
            android:layout_marginEnd="@dimen/space_l"
            android:src="@drawable/baseline_settings_24" android:contentDescription="@null"
            app:tint="@color/colorPrimary"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/App.Text.Title.M" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/config_privacy_title"/>
            <TextView style="@style/App.Text.Body.S" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs"
                android:text="@string/config_privacy_desc"/>
        </LinearLayout>
        <ImageView android:layout_width="@dimen/list_card_chevron_size"
            android:layout_height="@dimen/list_card_chevron_size"
            android:src="@drawable/baseline_chevron_right_24"
            android:contentDescription="@null" app:tint="@color/colorPrimary"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/text_version" style="@style/App.Text.Body.S"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center" android:text="@string/config_version_default"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>