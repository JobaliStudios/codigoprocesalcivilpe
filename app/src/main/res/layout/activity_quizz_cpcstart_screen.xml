<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/quiz_cpc_back"
                    android:padding="@dimen/space_m"
                    android:src="@drawable/baseline_arrow_back_24" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/quiz_cpc_header_title"
                    android:textColor="@color/quiz_text_title"
                    android:textSize="@dimen/text_title_m"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/space_m"
                    android:src="@drawable/baseline_highlight_alt_24"
                    app:tint="@color/quiz_icon_tint" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    android:background="@drawable/quiz_circle_icon_bg"
                    android:padding="38dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/baseline_menu_book_24"
                        app:tint="@color/quiz_icon_success_tint" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:text="@string/quiz_cpc_ready_title"
                    android:textColor="@color/quiz_text_title"
                    android:textSize="@dimen/text_title_l"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/quiz_cpc_ready_subtitle"
                    android:textAlignment="center"
                    android:textColor="@color/quiz_text_secondary"
                    android:textSize="@dimen/text_body_l" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/quiz_cpc_config_title"
                android:textColor="@color/quiz_text_secondary"
                android:textSize="@dimen/text_title_m"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/option5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                app:cardBackgroundColor="@color/quiz_option_default_bg"
                app:cardCornerRadius="@dimen/radius_l"
                app:strokeColor="@color/quiz_option_default_stroke"
                app:strokeWidth="@dimen/stroke_width_emphasis">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quiz_cpc_option_5"
                            android:textColor="@color/quiz_text_primary"
                            android:textSize="@dimen/text_title_l"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quiz_cpc_option_5_desc"
                            android:textColor="@color/quiz_text_secondary"
                            android:textSize="@dimen/text_body_l" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/option5Indicator"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@drawable/quiz_radio_unselected" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/option10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                app:cardBackgroundColor="@color/quiz_option_selected_bg"
                app:cardCornerRadius="@dimen/radius_l"
                app:strokeColor="@color/quiz_option_selected_stroke"
                app:strokeWidth="@dimen/stroke_width_emphasis">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quiz_cpc_option_10"
                            android:textColor="@color/quiz_text_primary"
                            android:textSize="@dimen/text_title_l"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quiz_cpc_option_10_desc"
                            android:textColor="@color/quiz_option_subtle_selected"
                            android:textSize="@dimen/text_body_l" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/option10Indicator"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@drawable/quiz_radio_selected" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/option20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                app:cardBackgroundColor="@color/quiz_option_default_bg"
                app:cardCornerRadius="@dimen/radius_l"
                app:strokeColor="@color/quiz_option_default_stroke"
                app:strokeWidth="@dimen/stroke_width_emphasis">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quiz_cpc_option_20"
                            android:textColor="@color/quiz_text_primary"
                            android:textSize="@dimen/text_title_l"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quiz_cpc_option_20_desc"
                            android:textColor="@color/quiz_text_secondary"
                            android:textSize="@dimen/text_body_l" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/option20Indicator"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@drawable/quiz_radio_unselected" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_width_thin"
                android:layout_marginTop="@dimen/space_xl"
                android:background="@color/quiz_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/quiz_cpc_info_time_title"
                android:textColor="@color/quiz_text_secondary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/quiz_cpc_info_time_value"
                android:textColor="@color/quiz_text_body"
                android:textSize="@dimen/text_title_m" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/quiz_cpc_info_content_title"
                android:textColor="@color/quiz_text_secondary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/quiz_cpc_info_content_value"
                android:textColor="@color/quiz_text_body"
                android:textSize="@dimen/text_title_m" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/quiz_cpc_info_difficulty_title"
                android:textColor="@color/quiz_text_secondary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/quiz_cpc_info_difficulty_value"
                android:textColor="@color/quiz_text_body"
                android:textSize="@dimen/text_title_m" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartQuiz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/quiz_cpc_start_button"
                android:textAllCaps="false"
                android:textColor="@color/quiz_button_on_primary"
                android:textSize="@dimen/text_title_m"
                android:textStyle="bold"
                app:backgroundTint="@color/quiz_button_primary"
                app:cornerRadius="30dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:text="@string/quiz_cpc_progress_warning"
                android:textColor="@color/quiz_text_warning"
                android:textSize="@dimen/text_body_l"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
