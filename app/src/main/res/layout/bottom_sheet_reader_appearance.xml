<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/reader_sheet_padding">

        <TextView
            style="@style/App.Text.Title.L"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reader_appearance_title" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/previewCard"
            style="@style/App.Card.Recurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/reader_preview_padding">

                <TextView
                    style="@style/App.Text.Body.S"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reader_appearance_preview_title" />

                <TextView
                    android:id="@+id/previewText"
                    style="@style/App.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/reader_appearance_preview_text" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/App.Text.Title.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/reader_appearance_theme" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/readerThemeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:saveEnabled="false"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/readerAuto"
                style="@style/App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="@dimen/space_xs"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/reader_theme_auto"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/readerLight"
                style="@style/App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="@dimen/space_xs"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/reader_theme_light"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/readerSepia"
                style="@style/App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="@dimen/space_xs"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/reader_theme_sepia"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/readerDark"
                style="@style/App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="@dimen/space_xs"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/reader_theme_dark"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            style="@style/App.Text.Title.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/reader_appearance_font" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/readerFontGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:saveEnabled="false"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fontSans"
                style="@style/App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/reader_font_sans"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fontSerif"
                style="@style/App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/reader_font_serif"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fontAccessible"
                style="@style/App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/reader_font_accessible"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="horizontal">

            <TextView
                style="@style/App.Text.Title.M"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_appearance_size" />

            <TextView
                android:id="@+id/fontScaleLabel"
                style="@style/App.Text.Body.M"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/fontScaleSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/reader_appearance_size"
            app:valueFrom="85"
            app:valueTo="160"
            app:stepSize="5"
            app:value="100" />

        <TextView
            style="@style/App.Text.Title.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/reader_appearance_lines" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/readerLineGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:saveEnabled="false"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lineCompact"
                style="@style/App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/reader_line_compact"
                android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/lineNormal"
                style="@style/App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/reader_line_normal"
                android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/lineWide"
                style="@style/App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/reader_line_wide"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            style="@style/App.Text.Title.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/reader_appearance_margins" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/readerMarginGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:saveEnabled="false"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/marginNarrow"
                style="@style/App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/reader_margin_narrow"
                android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/marginNormal"
                style="@style/App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/reader_margin_normal"
                android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/marginWide"
                style="@style/App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/reader_margin_wide"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/readerJustifySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:minHeight="@dimen/touch_target_min"
            android:saveEnabled="false"
            android:text="@string/reader_appearance_justify" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/readerFocusSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target_min"
            android:saveEnabled="false"
            android:text="@string/reader_appearance_focus" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/readerKeepAwakeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target_min"
            android:saveEnabled="false"
            android:text="@string/reader_appearance_keep_awake" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/appearanceReset"
                style="@style/App.Button.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/reader_appearance_reset" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/appearanceDone"
                style="@style/App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/reader_appearance_done" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
