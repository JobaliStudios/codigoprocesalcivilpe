<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chapterIndexArticleRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/space_xs"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/radius_l"
    app:strokeWidth="@dimen/stroke_width_thin"
    app:strokeColor="@color/colorOutline"
    app:cardBackgroundColor="@color/colorSurface">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/reader_index_item_min_height"
        android:orientation="horizontal"
        android:padding="@dimen/space_s">
        <TextView
            android:id="@+id/chapterIndexNumber"
            style="@style/App.Text.Title.M"
            android:layout_width="@dimen/reader_index_badge_size"
            android:layout_height="@dimen/reader_index_badge_size"
            android:gravity="center"
            android:background="@drawable/bg_icon_container"
            android:textColor="@color/colorPrimary"
            android:maxLines="1"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/chapterIndexSummary"
                style="@style/App.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/colorOnSurface"/>
            <TextView
                android:id="@+id/chapterIndexCurrent"
                style="@style/App.Text.Body.S"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textColor="@color/colorPrimary"
                android:visibility="gone"/>
        </LinearLayout>
        <TextView
            android:id="@+id/chapterIndexIndicators"
            style="@style/App.Text.Body.M"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:textColor="@color/colorPrimary"
            android:visibility="gone"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
