<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".favoritos.FavoritosFragment">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/favoritesControlsCard"
        style="@style/App.Card.Recurrent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_m"
        android:layout_marginTop="@dimen/space_s"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/favoritesControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_card"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonMyNotes"
                style="@style/App.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/my_notes_open_accessibility"
                android:text="@string/my_notes_open_action"
                app:icon="@drawable/baseline_note_24"
                app:iconGravity="textStart" />

            <SearchView
                android:id="@+id/favoriteSearchView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_search_field"
                android:iconifiedByDefault="false"
                android:minHeight="@dimen/touch_target_min"
                android:paddingHorizontal="@dimen/space_s"
                android:queryHint="@string/favorites_search_hint" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/favoriteFilterGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/favoriteFilterAll"
                        style="@style/App.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:checked="true"
                        android:text="@string/favorites_filter_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/favoriteFilterNotes"
                        style="@style/App.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/favorites_filter_notes" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/favoriteFilterHighlights"
                        style="@style/App.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/favorites_filter_highlights" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/App.Text.Body.S"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/favorites_sort_prefix" />

                <Spinner
                    android:id="@+id/spinnerSort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/favorites_sort_label"
                    android:minHeight="@dimen/touch_target_min"
                    android:spinnerMode="dropdown" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFavoritos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_m"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/favoritesControlsCard"
        tools:listitem="@layout/item_favorito" />

    <LinearLayout
        android:id="@+id/emptyStateFavoritos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_l"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_l"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/favoritesControlsCard"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/imageEmptyFavoritos"
            android:layout_width="@dimen/empty_state_icon_size"
            android:layout_height="@dimen/empty_state_icon_size"
            android:background="@drawable/bg_icon_container"
            android:contentDescription="@null"
            android:padding="@dimen/space_m"
            android:src="@drawable/baseline_favorite_border_24"
            app:tint="@color/colorPrimary" />

        <TextView
            android:id="@+id/textEmptyFavoritosTitle"
            style="@style/App.Text.Title.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center"
            android:text="@string/favorites_empty_title" />

        <TextView
            android:id="@+id/textFavoritos"
            style="@style/App.Text.Body.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:text="@string/no_favorites" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonExplorarCodigos"
            style="@style/App.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/favorites_cta_explore" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
