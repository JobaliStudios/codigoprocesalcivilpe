<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".favoritos.FavoritosFragment">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/favoritesControlsCard"
        style="@style/App.Card.Recurrent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_m"
        android:layout_marginTop="@dimen/space_s"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/favoritesControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_l">

            <Spinner
                android:id="@+id/spinnerSort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/favorites_sort_label" />

            <Spinner
                android:id="@+id/spinnerSectionFilter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:layout_weight="1"
                android:contentDescription="@string/favorites_filter_section_label" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFavoritos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_m"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/favoritesControlsCard"
        tools:listitem="@layout/item_favorito" />

    <LinearLayout
        android:id="@+id/emptyStateFavoritos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_l"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_l"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/favoritesControlsCard">

        <ImageView
            android:id="@+id/imageEmptyFavoritos"
            android:layout_width="@dimen/list_card_icon_size"
            android:layout_height="@dimen/list_card_icon_size"
            android:background="@drawable/bg_icon_container"
            android:contentDescription="@string/favorites_empty_icon_cd"
            android:padding="@dimen/space_m"
            android:src="@drawable/baseline_favorite_border_24"
            app:tint="@color/colorPrimary" />

        <TextView
            android:id="@+id/textEmptyFavoritosTitle"
            style="@style/App.Text.Subtitle.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center"
            android:text="@string/favorites_empty_title" />

        <TextView
            android:id="@+id/textFavoritos"
            style="@style/App.Text.Body.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:text="@string/no_favorites" />

        <Button
            android:id="@+id/buttonExplorarCodigos"
            style="@style/App.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/favorites_cta_explore" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
