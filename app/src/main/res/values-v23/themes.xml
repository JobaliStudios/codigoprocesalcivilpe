<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="Theme.codigoprocesalcivilpe" parent="Base.Theme.codigoprocesalcivilpe">
    <!-- Transparent system bars for edge-to-edge. -->
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
  </style>

  <style name="TOPCARDVIEWFONDO">
    <item name="backgroundTint">?attr/colorSurface</item>
  </style>

  <style name="IMAGEBOTONBUSQUEDA">
    <item name="backgroundTint">?attr/colorOnSurface</item>
    <item name="tint">?attr/colorSurface</item>
  </style>

  <style name="EditTextSearchStyle">
    <item name="android:textColor">?attr/colorOnSurface</item>
    <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
    <item name="drawableTint">?attr/colorOnSurfaceVariant</item>
    <item name="android:background">?attr/colorSurface</item>
  </style>

  <style name="upBreadcrumb">
    <item name="android:textColor">?attr/colorOnSurface</item>
    <item name="android:background">?attr/colorSurfaceVariant</item>
  </style>

  <style name="Breadcrumb">
    <item name="android:textColor">?attr/colorPrimary</item>
    <item name="android:background">?attr/colorSurfaceVariant</item>
  </style>

</resources>
